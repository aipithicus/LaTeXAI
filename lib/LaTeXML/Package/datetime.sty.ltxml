# datetime 2.60 (2015/03/20), datetime.sty:78-148,175-189,564-565.
# Class: semantic. Numeric custom date formats and selector scope.
# Localized weekday/ordinal defaults and time APIs are unsupported; the
# engine's ordinary today remains until a supported format is selected.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;
ProcessOptions();
for my $pair (['day','DAY'],['month','MONTH'],['year','YEAR']) {
 DefRegister('\\@'.$pair->[0],Number(0));
 Let('\\c@'.$pair->[1],'\\@'.$pair->[0]);
 DefMacro('\\THE'.$pair->[1],'\\the\\@'.$pair->[0]);
}
DefMacro('\twodigit {Number}',sub {return Explode(sprintf('%02d',$_[1]->valueOf));});
DefMacro('\dateseparator','/');
DefMacro('\dateformat {} {} {} {}','\@day=#2\relax\@month=#3\relax\@year=#4\relax#1');
sub _dt_select {
 my ($pattern)=@_;
 DefMacro('\formatdate {} {} {}',sub {return Invocation(T_CS('\dateformat'),$pattern,@_[1..3]);});
 DefMacro('\today','\formatdate{\day}{\month}{\year}');
 return;
}
DefPrimitive('\newdateformat {} {}',sub {
 my ($stomach,$arg,$pattern)=@_;my $name=ToString($arg);
 if (IsDefined(T_CS('\\'.$name))) {Error('unexpected','datetime-format',$stomach,"Date format '$name' already exists");return;}
 DefMacroI(T_CS('\\'.$name),undef,sub {_dt_select($pattern);return ();});
 return;
});
for my $pair (
 ['yyyymmdddate','\THEYEAR\dateseparator\twodigit\THEMONTH\dateseparator\twodigit\THEDAY'],
 ['ddmmyyyydate','\twodigit\THEDAY\dateseparator\twodigit\THEMONTH\dateseparator\THEYEAR'],
 ['dmyyyydate','\THEDAY\dateseparator\THEMONTH\dateseparator\THEYEAR']) {
 my $pattern=Tokenize($pair->[1]);
 DefMacroI(T_CS('\\'.$pair->[0]),undef,sub {_dt_select($pattern);return ();});
}
1;
