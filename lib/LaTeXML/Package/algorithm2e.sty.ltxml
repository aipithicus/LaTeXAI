package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# CTAN: algorithm2e v5.2 (rev 77682)
# Pure native binding eliminating InputDefinitions('algorithm2e') and latin1 hacks.

RequirePackage('float');

# Package options:
AssignValue('algorithm_print_semicolon' => 1);
AssignValue('algocf_linesnumbered'      => 0);
AssignValue('algocf_noend'              => 0);
AssignValue('algocf_style'              => 'plain');

DeclareOption('linesnumbered', sub {
  AssignValue('algocf_linesnumbered' => 1);
});
DeclareOption('linesnumberedhidden', sub {
  AssignValue('algocf_linesnumbered' => 0);
});
DeclareOption('commentsnumbered', sub {
  AssignValue('algocf_commentsnumbered' => 1);
});
DeclareOption('noend', sub {
  AssignValue('algocf_noend' => 1);
});
DeclareOption('lined', sub {
  AssignValue('algocf_lined' => 'lined');
});
DeclareOption('vlined', sub {
  AssignValue('algocf_lined' => 'vlined');
});
DeclareOption('noline', sub {
  AssignValue('algocf_lined' => 'noline');
});
DeclareOption('boxed', sub {
  AssignValue('algocf_style' => 'boxed');
});
DeclareOption('boxruled', sub {
  AssignValue('algocf_style' => 'boxruled');
});
DeclareOption('ruled', sub {
  AssignValue('algocf_style' => 'ruled');
});
DeclareOption('algoruled', sub {
  AssignValue('algocf_style' => 'algoruled');
});
DeclareOption('plain', sub {
  AssignValue('algocf_style' => 'plain');
});

ProcessOptions();

# Configuration commands:
DefMacro('\DontPrintSemicolon', sub {
  AssignValue('algorithm_print_semicolon' => 0);
  return ();
});
DefMacro('\PrintSemicolon', sub {
  AssignValue('algorithm_print_semicolon' => 1);
  return ();
});
DefMacro('\LinesNumbered', sub {
  AssignValue('algocf_linesnumbered' => 1);
  return ();
});
DefMacro('\LinesNotNumbered', sub {
  AssignValue('algocf_linesnumbered' => 0);
  return ();
});
DefMacro('\LinesNumberedHidden', sub {
  AssignValue('algocf_linesnumbered' => 0);
  return ();
});
DefMacro('\RestyleAlgo{}', sub {
  AssignValue('algocf_style' => ToString($_[1]));
  return ();
});
DefMacro('\SetAlgoLined', sub {
  AssignValue('algocf_lined' => 'lined');
  return ();
});
DefMacro('\SetAlgoVlined', sub {
  AssignValue('algocf_lined' => 'vlined');
  return ();
});
DefMacro('\SetAlgoNoLine', sub {
  AssignValue('algocf_lined' => 'noline');
  return ();
});

# Counters:
NewCounter('algorithm');
DefMacro('\fnum@algorithm',      '\algorithmcfname\nobreakspace\thealgorithm');
DefMacro('\fnum@font@algorithm', '\bfseries');
DefMacro('\ext@algorithm',       'loa');
DefMacro('\algorithmcfname',     'Algorithm');

NewCounter('AlgoLine', undef, idprefix => 'l');
DefMacro('\theAlgoLine', '\arabic{AlgoLine}');

# Indentation handling:
NewCounter('lx@algo@indent_level');
DefMacro('\lx@algo@indent', sub {
  StepCounter('lx@algo@indent_level');
  return ();
});
DefMacro('\lx@algo@endindent', sub {
  my $v = CounterValue('lx@algo@indent_level')->valueOf;
  ResetCounter('lx@algo@indent_level', $v > 0 ? $v - 1 : 0);
  return ();
});

# Semicolon and line handling:
Let(T_CS('\@mathsemicolon'), T_CS('\;'));

Tag('ltx:listingline', autoClose => 1);

DefConstructor('\lx@algo@@endline', "</ltx:listingline>");
DefConstructor('\lx@algo@@startline',
  "<ltx:listingline xml:id='#id' refnum='#refnum'>"
    . "?&defined(#tags)(#tags)()",
  beforeConstruct => sub {
    $_[0]->maybeCloseElement('ltx:listingline');
  },
  properties => sub {
    if (LookupValue('algocf_linesnumbered')) {
      StepCounter('AlgoLine');
      my $refnum = CounterValue('AlgoLine')->valueOf;
      my $id     = Digest(T_CS('\theAlgoLine@ID'));
      my $tags   = Digest(Invocation(T_CS('\lx@make@tags'), T_OTHER('AlgoLine')));
      return (id => $id, refnum => $refnum, tags => $tags);
    }
    return ();
  });

DefMacro('\lx@algo@startline', sub {
  my $level = CounterValue('lx@algo@indent_level')->valueOf;
  my @tokens = (T_CS('\lx@algo@@startline'));
  if ($level > 0) {
    push(@tokens, T_CS('\hskip'), Explode(($level * 1.5) . 'em'), T_CS('\relax'));
  }
  return Tokens(@tokens);
});

DefMacro('\lx@algo@newline', sub {
  return Tokens(T_CS('\lx@algo@startline'));
});

DefMacro('\lx@algo@semicolon', sub {
  # Real algorithm2e: \def\;{\ifmmode\@mathsemicolon\else\@endalgoln\fi}
  if (LookupValue('IN_MATH')) {
    return T_CS('\@mathsemicolon');
  }
  my @tokens = ();
  if (LookupValue('algorithm_print_semicolon')) {
    push(@tokens, T_OTHER(';'));
  }
  push(@tokens, T_CS('\lx@algo@startline'));
  return @tokens;
});

DefMacro('\BlankLine', '\lx@algo@newline');

# Float environments:
for my $env (qw(algorithm algorithm2e algorithm* procedure procedure* function function*)) {
  DefEnvironment("{$env}[]",
    "<ltx:float xml:id='#id' class='ltx_algorithm'>"
      . "#tags"
      . "<ltx:listing class='ltx_lst_numbers_left'>"
      . "#body"
      . "</ltx:listing></ltx:float>",
    mode         => 'internal_vertical',
    beforeDigest => sub {
      ResetCounter('AlgoLine');
      ResetCounter('lx@algo@indent_level');
      Let('\par',   '\relax');
      Let("\\\\",   '\lx@algo@newline');
      Let('\;',     '\lx@algo@semicolon');
      beforeFloat('algorithm');
    },
    afterDigestBegin => sub {
      $_[0]->getGullet->unread(T_CS('\lx@algo@startline'));
    },
    afterDigest => sub {
      my $st = LookupValue('algocf_style') || '';
      if ($st =~ /box/) {
        $_[1]->setProperty(frame => 'boxed');
      }
      afterFloat($_[1]);
    },
    afterConstruct => sub {
      my ($doc, $whatsit) = @_;
      $_[0]->maybeCloseElement('ltx:listingline');
      my $float = $doc->getNode->lastChild;
      if ($float) {
        my ($listing) = grep { $doc->getNodeQName($_) eq 'ltx:listing' } $float->childNodes;
        if ($listing) {
          my @lines = grep { $doc->getNodeQName($_) eq 'ltx:listingline' } $listing->childNodes;
          if (@lines) {
            my $last = $lines[-1];
            my @content = grep { $doc->getNodeQName($_) ne 'ltx:tags' } $last->childNodes;
            my $txt = join('', map { $_->textContent } @content);
            if (!@content || $txt =~ /^\s*$/) {
              $listing->removeChild($last);
            }
          }
        }
      }
      addFloatFrames($_[0], $_[1]->getProperty('frame'));
    }
  );
}

DefMacro('\TitleOfAlgo{}', '\caption{#1}');

# Comments. Source: \SetKwComment{tcc}{/* }{ */} \SetKwComment{tcp}{// }{}
# Unstarred form ends the line; starred form takes optional [l/r/h/f] and does not.
sub _algo_read_comment {
  my ($gullet) = @_;
  $gullet->skipSpaces;
  my $star = $gullet->ifNext(T_OTHER('*')) ? $gullet->readToken : undef;
  $gullet->skipSpaces;
  my $side;
  if ($gullet->ifNext(T_OTHER('['))) {
    $side = $gullet->readOptional;
  }
  my $text = $gullet->readArg;
  return ($star, $side, $text);
}

sub _algo_comment_tokens {
  my ($star, $text, $start, $end) = @_;
  my @toks = (Explode($start), ($text ? $text->unlist : ()), Explode($end));
  push(@toks, T_CS('\;')) unless $star;
  return Tokens(@toks);
}

DefMacro('\SetKwComment Semiverbatim Semiverbatim Semiverbatim', sub {
  my ($gullet, $cmd, $start, $end) = @_;
  my $cs = clean_cs_name($cmd);
  my $s  = ToString($start);
  my $e  = ToString($end);
  DefMacro('\\' . $cs, sub {
      my ($g) = @_;
      my ($star, $side, $text) = _algo_read_comment($g);
      return _algo_comment_tokens($star, $text, $s, $e);
  });
  return ();
});
DefMacro('\tcp', sub {
    my ($star, $side, $text) = _algo_read_comment($_[0]);
    return _algo_comment_tokens($star, $text, '// ', '');
});
DefMacro('\tcc', sub {
    my ($star, $side, $text) = _algo_read_comment($_[0]);
    return _algo_comment_tokens($star, $text, '/* ', ' */');
});

# Constants. Trailing \space so a following $ does not join the font run.
DefMacro('\KwTo',     '\textbf{to}\space');
DefMacro('\KwRet',    '\textbf{return}\space');
DefMacro('\Return{}', '\textbf{return}\space #1');
DefMacro('\lReturn{}','\textbf{return}\space #1\;');
DefMacro('\True',     '\textbf{true}\space');
DefMacro('\False',    '\textbf{false}\space');
DefMacro('\Nil',      '\textbf{nil}\space');

# Built-in Input/Output keywords:
DefMacro('\KwIn{}',     '\textbf{Input:}\space #1\;');
DefMacro('\KwOut{}',    '\textbf{Output:}\space #1\;');
DefMacro('\KwData{}',   '\textbf{Data:}\space #1\;');
DefMacro('\KwResult{}', '\textbf{Result:}\space #1\;');

# Declarative keyword creators:
sub clean_cs_name {
  my ($cs) = @_;
  $cs = ToString($cs);
  $cs =~ s/^\\//;
  $cs =~ s/^\s+//;
  $cs =~ s/\s+$//;
  return $cs;
}

DefMacro('\SetKw Semiverbatim Semiverbatim', sub {
  my ($gullet, $cmd, $text) = @_;
  my $cs = clean_cs_name($cmd);
  DefMacro('\\' . $cs, '\textbf{' . ToString($text) . '}\space');
  return ();
});

DefMacro('\SetKwInOut Semiverbatim Semiverbatim', sub {
  my ($gullet, $cmd, $label) = @_;
  my $cs = clean_cs_name($cmd);
  DefMacro('\\' . $cs . ' {}', '\textbf{' . ToString($label) . ':}\space #1\;');
  return ();
});
DefMacro('\SetKwInput Semiverbatim Semiverbatim', '\SetKwInOut{#1}{#2}');

DefMacro('\SetKwData Semiverbatim Semiverbatim', sub {
  my ($gullet, $cmd, $text) = @_;
  my $cs = clean_cs_name($cmd);
  DefMacro('\\' . $cs, '\textsf{' . ToString($text) . '}');
  return ();
});

DefMacro('\SetKwFunction Semiverbatim Semiverbatim', sub {
  my ($gullet, $cmd, $text) = @_;
  my $cs = clean_cs_name($cmd);
  DefMacro('\\' . $cs . ' {}', '\texttt{' . ToString($text) . '}(#1)');
  return ();
});

DefMacro('\SetKwBlock Semiverbatim Semiverbatim Semiverbatim', sub {
  my ($gullet, $cmd, $start, $end) = @_;
  my $cs = clean_cs_name($cmd);
  DefMacro('\\' . $cs . ' {}',
    '\textbf{' . ToString($start) . '}\;\lx@algo@indent #1\lx@algo@endindent\textbf{' . ToString($end) . '}\;');
  return ();
});

DefMacro('\SetKwComment Semiverbatim Semiverbatim Semiverbatim', sub {
  my ($gullet, $cmd, $start, $end) = @_;
  my $cs = clean_cs_name($cmd);
  DefMacro('\\' . $cs . ' OptionalMatch:* {}',
    ToString($start) . ' #2 ' . ToString($end));
  return ();
});

# Control structures:
DefMacro('\If{}{}', sub {
  my ($gullet, $cond, $body) = @_;
  my $noend = LookupValue('algocf_noend');
  Tokens(T_CS('\textbf'), T_BEGIN, Explode('if'), T_END, T_SPACE,
         $cond->unlist, T_SPACE,
         T_CS('\textbf'), T_BEGIN, Explode('then'), T_END, T_CS('\;'),
         T_CS('\lx@algo@indent'), $body->unlist, T_CS('\lx@algo@endindent'),
         $noend ? () : (T_CS('\textbf'), T_BEGIN, Explode('end'), T_END, T_CS('\;')));
});

DefMacro('\eIf{}{}{}', sub {
  my ($gullet, $cond, $then, $else) = @_;
  my $noend = LookupValue('algocf_noend');
  Tokens(T_CS('\textbf'), T_BEGIN, Explode('if'), T_END, T_SPACE,
         $cond->unlist, T_SPACE,
         T_CS('\textbf'), T_BEGIN, Explode('then'), T_END, T_CS('\;'),
         T_CS('\lx@algo@indent'), $then->unlist, T_CS('\lx@algo@endindent'),
         T_CS('\textbf'), T_BEGIN, Explode('else'), T_END, T_CS('\;'),
         T_CS('\lx@algo@indent'), $else->unlist, T_CS('\lx@algo@endindent'),
         $noend ? () : (T_CS('\textbf'), T_BEGIN, Explode('end'), T_END, T_CS('\;')));
});

DefMacro('\uIf{}{}',
  '\textbf{if}\space #1\space\textbf{then}\;\lx@algo@indent #2\lx@algo@endindent');
DefMacro('\lIf{}{}',
  '\textbf{if}\space #1\space\textbf{then}\space #2\;');

