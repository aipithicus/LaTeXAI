# \SetKwSwitch{Switch}{Case}{Other}{switch}{do}{case}{otherwise}{end case}{end switch}
DefMacro('\SetKwSwitch Semiverbatim Semiverbatim Semiverbatim {}{}{}{}{}{}', sub {
  my ($gullet, $switch, $case, $other, $sw_txt, $do_txt, $case_txt, $other_txt, $endcase, $endsw) = @_;
  my $sw = clean_cs_name($switch);
  my $cs = clean_cs_name($case);
  my $ot = clean_cs_name($other);
  my $swt = ToString($sw_txt);
  my $dot = ToString($do_txt);
  my $ct  = ToString($case_txt);
  my $otx = ToString($other_txt);
  my $ec  = ToString($endcase);
  my $es  = ToString($endsw);
  DefMacro('\\' . $sw . ' {}{}', sub {
      my ($g, $cond, $body) = @_;
      my $noend = LookupValue('algocf_noend');
      Tokens(T_CS('\textbf'), T_BEGIN, Explode($swt), T_END, T_SPACE,
        $cond->unlist, T_SPACE,
        T_CS('\textbf'), T_BEGIN, Explode($dot), T_END, T_CS('\;'),
        T_CS('\lx@algo@indent'), $body->unlist, T_CS('\lx@algo@endindent'),
        $noend ? () : (T_CS('\textbf'), T_BEGIN, Explode($es), T_END, T_CS('\;')));
  });
  DefMacro('\\' . $cs . ' {}{}', sub {
      my ($g, $val, $body) = @_;
      my $noend = LookupValue('algocf_noend');
      Tokens(T_CS('\textbf'), T_BEGIN, Explode($ct), T_END, T_SPACE,
        $val->unlist, T_SPACE,
        T_CS('\textbf'), T_BEGIN, Explode($dot), T_END, T_CS('\;'),
        T_CS('\lx@algo@indent'), $body->unlist, T_CS('\lx@algo@endindent'),
        $noend ? () : (T_CS('\textbf'), T_BEGIN, Explode($ec), T_END, T_CS('\;')));
  });
  DefMacro('\\' . $ot . ' {}', sub {
      my ($g, $body) = @_;
      my $noend = LookupValue('algocf_noend');
      Tokens(T_CS('\textbf'), T_BEGIN, Explode($otx), T_END, T_SPACE,
        T_CS('\textbf'), T_BEGIN, Explode($dot), T_END, T_CS('\;'),
        T_CS('\lx@algo@indent'), $body->unlist, T_CS('\lx@algo@endindent'),
        $noend ? () : (T_CS('\textbf'), T_BEGIN, Explode($ec), T_END, T_CS('\;')));
  });
  return ();
});
Digest(Tokenize('\SetKwSwitch{Switch}{Case}{Other}{switch}{do}{case}{otherwise}{end case}{end switch}'));

#**********************************************************************
1;
