# Native built-in float subset, audited against rotfloat 1.2 (2004-01-04),
# lib-ctan/rotfloat/tex/latex/rotfloat/rotfloat.sty, TeX Live revision 79618,
# and the package documentation. CTAN gives no date; the runfile supplies it.
# Model: float.sty.ltxml and rotating.sty.ltxml's beforeFloat/afterFloat loop.
# Covers sidewaysfigure/sidewaystable and their starred forms, placement,
# captions, numbering and labels. The established class and 90-degree trace
# are retained; page-dependent rotation and custom floats generated through
# restylefloat are not implemented here. Inherited float styling no-ops do
# not implement rotfloat's dynamic sideways-environment generation.
# The raw source also requires rotating, whose binding executes the ifthen
# passthrough. This native subset uses float and the engine float primitives
# directly; it does not load rotating or expose its unrelated environments.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

RequirePackage('float');

foreach my $type (qw(table figure)) {
  foreach my $star ('', '*') {
    DefEnvironment('{sideways' . $type . $star . '}[]',
      "<ltx:$type xml:id='#id' inlist='#inlist' ?#1(placement='#1')"
        . " class='ltx_sideways$type' angle='90'>#tags#body</ltx:$type>",
      mode         => 'internal_vertical',
      beforeDigest => sub {
        beforeFloat($type, double => ($star ? 1 : 0));
        AssignRegister('\hsize' => LookupRegister('\textheight')); },
      afterDigest  => sub { afterFloat($_[1]); });
  }
}

1;
