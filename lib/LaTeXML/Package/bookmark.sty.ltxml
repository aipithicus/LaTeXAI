package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# CTAN: bookmark v1.32 (rev 79461)
# Pure native binding eliminating InputDefinitions('bookmark').

RequirePackage('hyperref');

# Ignore package options (driver options, draft, etc.)
DeclareOption(undef, sub { });
ProcessOptions();

# Core bookmark creation commands:
DefMacro('\bookmark[]{}', sub {
  my ($gullet, $options, $title) = @_;
  return ();
});

DefMacro('\subbookmark[]{}{}', sub {
  my ($gullet, $options, $level, $title) = @_;
  return ();
});

# Setup and configuration macros:
DefMacro('\bookmarksetup{}',                     '');
DefMacro('\bookmarksetupnext{}',                 '');
DefMacro('\bookmarkdefinestyle{Semiverbatim}{}', '');
# \bookmarkget{key} reads back a \bookmarksetup key; numeric keys default to 0.
DefMacro('\bookmarkget{}', sub {
  my $key = ToString($_[1]); $key =~ s/^\s+|\s+$//g;
  return Explode(($key =~ /^(level|openlevel|startatroot|depth)$/) ? '0' : ''); });
DefMacro('\BookmarkAtEnd{}',                     '\AtEndDocument{#1}');
DefMacro('\currentbookmarklevel',                '0');

# Compatibility wrappers:
DefMacro('\pdfbookmark[]{}{}',      '');
DefMacro('\currentpdfbookmark{}{}', '');
DefMacro('\subpdfbookmark{}{}',     '');
DefMacro('\belowpdfbookmark{}{}',   '');

1;
