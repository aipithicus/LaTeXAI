# Native stub replacing InputDefinitions('pgfmath.code'). Does not run
# the PGF math parser. \pgfmathparse and friends set \pgfmathresult to 0.
# Coordinate trigonometry is out of containment scope.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

RequirePackage('pgfrcs');
RequirePackage('pgfkeys');

DeclareOption(undef, sub { });
ProcessOptions();

DefMacro('\pgfmathresult', '0');
DefMacro('\pgfmathparse{}', '\def\pgfmathresult{0}');
DefMacro('\pgfmathqparse{}', '\def\pgfmathresult{0}');
DefMacro('\pgfmathpostparse', '');

DefPrimitive('\pgfmathsetmacro DefToken {}', sub {
    my ($stomach, $cs, $expr) = @_;
    DefMacroI($cs, undef, '0');
    return; });
DefPrimitive('\pgfmathtruncatemacro DefToken {}', sub {
    my ($stomach, $cs, $expr) = @_;
    DefMacroI($cs, undef, '0');
    return; });
DefPrimitive('\pgfmathsetlengthmacro DefToken {}', sub {
    my ($stomach, $cs, $expr) = @_;
    DefMacroI($cs, undef, '0pt');
    return; });

DefMacro('\pgfmathsetlength DefToken {}', '#1=0pt\relax');
DefMacro('\pgfmathaddtolength DefToken {}', '');
DefMacro('\pgfmathsetcount DefToken {}', '#1=0\relax');
DefMacro('\pgfmathaddtocount DefToken {}', '');
DefMacro('\pgfmathreciprocal{}', '\def\pgfmathresult{0}');
DefMacro('\pgfmathsqrt{}', '\def\pgfmathresult{0}');
DefMacro('\pgfmathveclen{}{}', '\def\pgfmathresult{0}');
DefMacro('\pgfmathifthenelse{}{}{}', '#2');
DefConditional('\ifpgfmathunitsdeclared');
DefConditional('\ifpgfmathmathunitsdeclared');

1;
