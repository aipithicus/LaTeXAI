# Native stub replacing InputDefinitions('pgfplots'). Axis environments
# inside {tikzpicture} are token-captured with the picture and harvested
# for node text and math; they are not executed. Written from the
# pgfplots 1.18 manual surface used in papers, not a plot renderer.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

RequirePackage('tikz');

DeclareOption(undef, sub { });
ProcessOptions();

DefMacro('\pgfplotsset{}', '');
DefMacro('\usepgfplotslibrary{}', '');
DefMacro('\pgfplotscreateplotcyclelist{}{}', '');
DefMacro('\pgfplotsinvokeforeach{}{}', '#2');
DefMacro('\pgfplotstableread[]{}{}', '');
DefMacro('\pgfplotstabletypeset[]{}', '');

foreach my $env (qw(axis semilogxaxis semilogyaxis loglogaxis
    polaraxis smithchart groupplot ternaryaxis)) {
  DefMacroI(T_CS("\\begin{$env}"), undef, sub {
      return tikz_contain_begin_env($_[0], $env, 'ltx_tikz'); });
  DefMacroI('\\' . $env, undef, sub {
      my ($gullet) = @_;
      my $opts = tikz_contain_read_options($gullet);
      my $body = tikz_contain_read_env_body($gullet, $env);
      return tikz_contain_emit($body, 'ltx_tikz',
        tikz_contain_raw_cmd($env, $opts, undef, $body, T_CS('\end' . $env))); });
  DefMacroI('\\end' . $env, undef, ''); }

1;
