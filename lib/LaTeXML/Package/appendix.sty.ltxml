package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

#======================================================================
# Chapter/section appendix structure and source reset/save/restore helpers,
# checked against appendix 1.2c (2020/02/08). Contents entries use the native
# addcontentsline contract; running heads and physical pages are layout only.

# Heading content follows appendix 1.2c's @sec@pppage/@chap@pppage;
# physical page breaks are not part of the document object.
DefConstructor('\lx@pp@heading{}',
  "<ltx:block class='ltx_appendix_heading'><ltx:p>#1</ltx:p></ltx:block>",
  bounded => 1,
  beforeConstruct => sub { $_[0]->maybeCloseElement('ltx:p'); });
DefMacro('\appendixpage', '\par\lx@pp@heading{\normalfont\huge\bfseries\appendixpagename}'
  . '\if@dotoc@pp\addappheadtotoc\fi');
# Use the kernel's contents-line contract, as the package source does.
DefMacro('\addappheadtotoc', '\if@chapter@pp'
  . '\addcontentsline{toc}{chapter}{\appendixtocname}\else'
  . '\addcontentsline{toc}{section}{\appendixtocname}\fi');
DefMacro('\clear@ppage', '\clearpage');

DefMacro('\appendixname',     "Appendix");
DefMacro('\appendixtocname',  "Appendices");
DefMacro('\appendixpagename', "Appendices");

# Whether the entry in toc gets page number; Ignorable
DefMacro('\appendicestocpagenum',   Tokens());
DefMacro('\noappendicestocpagenum', Tokens());

# Switches, mostly ignorable(?)
DefConditional('\if@dotoc@pp');
DefConditional('\if@dotitle@pp');
DefConditional('\if@dotitletoc@pp');
DefConditional('\if@dohead@pp');
DefConditional('\if@dopage@pp');
DefConditional('\if@chapter@pp', sub { IsDefined(T_CS('\chapter')); });
foreach my $option (qw(toc title titletoc header page)) {
  my $switch = $option eq 'header' ? 'dohead' : 'do' . $option;
  DeclareOption($option, sub { Let('\\if@' . $switch . '@pp', T_CS('\iftrue')); return; });
}
ProcessOptions();

DefMacro('\appendixtocon',       '\@dotoc@pptrue');
DefMacro('\appendixtocoff',      '\@dotoc@ppfalse');
DefMacro('\appendixpageon',      '\@dopage@pptrue');
DefMacro('\appendixpageoff',     '\@dopage@ppfalse');
DefMacro('\appendixtitleon',     '\@dotitle@pptrue');
DefMacro('\appendixtitleoff',    '\@dotitle@ppfalse');
DefMacro('\appendixtitletocon',  '\@dotitletoc@pptrue');
DefMacro('\appendixtitletocoff', '\@dotitletoc@ppfalse');
DefMacro('\appendixheaderon',    '\@dohead@pptrue');
DefMacro('\appendixheaderoff',   '\@dohead@ppfalse');

# DefMacro('\phantomsection',Tokens());

# DefMacro('\restoreapp',Tokens());

# DefMacro('\sectionname',Tokens());
# DefMacro('\subsectionname',Tokens());

DefMacro('\setthesection',    '\Alph{section}');
DefMacro('\setthesubsection', '\thesection.\Alph{subsection}');

sub _appendix_counter { return IsDefined(T_CS('\c@chapter')) ? 'chapter' : 'section'; }
DefPrimitive('\@ppsavesec', sub {
    AssignValue('appendix_saved_section' => CounterValue(_appendix_counter()), 'global');
    return; });
DefPrimitive('\@ppsaveapp', sub {
    AssignValue('appendix_saved_appendix' => CounterValue(_appendix_counter()), 'global');
    return; });
DefPrimitive('\restoreapp', sub {
    SetCounter(_appendix_counter(), LookupValue('appendix_saved_appendix') || Number(0));
    return; });
DefPrimitive('\@resets@pp', sub {
    my $counter = _appendix_counter();
    AssignValue('appendix_saved_section' => CounterValue($counter), 'global');
    beginAppendices($counter);
    SetCounter($counter, LookupValue('appendix_saved_appendix') || Number(0));
    return; });

DefConstructor('\@pprestoresec', sub {
    $_[0]->maybeCloseElement('ltx:appendix'); },
  beforeDigest => sub {
    endAppendices();
    SetCounter(_appendix_counter(), LookupValue('appendix_saved_section') || Number(0));
    return; });

# Adjust numbering!!!
DefPrimitive('\lx@pp@subappendix@begin', sub {
    if (LookupDefinition(T_CS('\c@chapter'))) {
      beginAppendices('section'); }
    else {
      beginAppendices('subsection'); } });

#DefEnvironment('{appendices}','#body');
DefMacro('\appendices',
  '\@resets@pp'
    . '\if@dopage@pp\appendixpage\else\if@dotoc@pp\addappheadtotoc\fi\fi'
    . '\if@dotitle@pp\def\fnum@appendix{\lx@refnum@compose{\appendixname}{\lx@the@@{appendix}}}\fi'
    . '\if@dotitletoc@pp\def\fnum@toc@appendix{\lx@refnum@compose{\appendixname}{\lx@the@@{appendix}}}\fi'
);

# These must END appendices!!!!
# AND CLOSE an open appendix!
DefMacro(T_CS('\endappendices'), '\@ppsaveapp\@pprestoresec');

# DefEnvironment('{subappendices}','#body');
DefMacro(T_CS('\subappendices'),    '\lx@pp@subappendix@begin');
DefConstructor('\endsubappendices', sub { $_[0]->maybeCloseElement('ltx:appendix'); },
  beforeDigest => sub { endAppendices(); });

#======================================================================
1;
