# attrib 1.3 (2001/08/31), written from Frankenstein attrib.sty.
# Class: structural. Attribution text, configurable delimiters/initialization,
# and minimum spacing. Frankenstein citation-style switching is not emulated.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;
ProcessOptions();
DefRegister('\AttribMinSkip' => Dimension('2em'));
DefMacro('\PreTrib', '(');
DefMacro('\PostTrib', ')');
DefMacro('\AttribInit', '');
DefConstructor('\lx@attrib{}', "<ltx:text class='ltx_attribution'>#1</ltx:text>");
DefMacro('\attrib{}', '{\AttribInit\hskip\AttribMinSkip\relax'
  . '\lx@attrib{{\PreTrib\relax#1}{\PostTrib}}}\par');
1;
