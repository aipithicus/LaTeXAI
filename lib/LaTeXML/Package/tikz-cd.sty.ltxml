# Native structural subset of tikz-cd 1.0 (2021-05-04), audited against
# lib-ctan/tikz-cd/tex/latex/tikz-cd/tikz-cd.sty and
# tex/generic/tikz-cd/tikzlibrarycd.code.tex, TeX Live revision 77682,
# plus the package documentation. Model: amscd's generic matrix bindings.
# This replaces the upstream TikZ passthrough: raw tikz-cd requires tikz and
# loads cd (matrix, quotes, arrows.meta); this binding requires no packages,
# executes no raw TikZ, and defines tikzcdset (and tikzset only when TikZ has
# not already provided it) for the bounded layout no-ops below. Loading it
# does not expose TikZ's unrelated surface.
# Covers the tikzcd matrix, including standalone use outside math (wrapped in
# ltx:Math, not a numbered equation), arrow/ar bracket syntax, nonempty
# r/l/u/d direction strings (cd:dir is the source spelling; the twelve DIR_MAP
# keys keep their glyphs, other chains use net displacement), one quoted math
# label with prime/swap, numeric from/to, and the style branches listed below.
# Case-insensitive direction shortcuts are an existing fork extension. Bends,
# valued and bare shift left/right, a closed set of xcolor names, and
# decorations retain cd:style traces; exact path geometry, color rendering,
# and orientation of composite glyphs are not rendered.
# Dense adjacent edges can retain explicit parser residue. Endpoint resolution
# keeps the existing explicit-to precedence and direction-relative-to-from
# convention; general source-order routing semantics remain a design follow-up.
# Old brace syntax/rar-family commands, multiple or styled quote labels,
# arbitrary/named routes, other arrow styles and non-layout settings are
# unsupported. They must not silently become a default rightward edge.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;
use LaTeXML::Core::Token;
use LaTeXML::Core::Tokens;

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# Structural binding for tikz-cd: maps commutative diagrams to an
# alignment matrix with datameaning=commutative-diagram and structured
# arrow constructs, rather than delegating to TikZ / SVG picture generation.
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

sub check_tikzcd_layout_options {
  my ($options) = @_;
  return unless defined $options;
  foreach my $item (split_token_items($options)) {
    my $text = ToString(Tokens(@$item));
    $text =~ s/^\s+|\s+$//g;
    next unless length($text);
    # Grid spacing/baseline are page layout, not nodes, labels or edges.
    next if $text =~ /^(?:row sep|column sep|sep|baseline)\s*=\s*\S/s;
    next if $text eq 'cramped';
    # The existing local binding already makes \& an alignment separator.
    next if $text =~ /^ampersand replacement\s*=\s*\\&$/;
    Error('unsupported', 'tikzcd-setting', undef,
      "Unsupported tikz-cd setting (not silently ignored): $text");
  }
  return;
}
DefMacro('\tikzcdset{}', sub { check_tikzcd_layout_options($_[1]); return; });
# Native TikZ already absorbs \tikzset. Do not replace that with the
# tikz-cd layout checker, or a document that loads both would error on
# ordinary TikZ keys.
if (!LookupDefinition(T_CS('\tikzset'))) {
  DefMacro('\tikzset{}', sub { check_tikzcd_layout_options($_[1]); return; }); }

# Reader for optional [options] on \tikzcd or \arrow
DefParameterType('OptionalTikzCdOptions', sub {
    my ($gullet) = @_;
    $gullet->skipSpaces;
    if ($gullet->ifNext(T_OTHER('['))) {
      $gullet->readToken;    # consume '['
      my @toks = ();
      my $depth = 0;
      my $braces = 0;
      my $closed = 0;
      while (defined(my $tok = $gullet->readToken)) {
        if ($tok->getCatcode == CC_BEGIN) {
          $braces++;
          push(@toks, $tok);
        }
        elsif ($tok->getCatcode == CC_END) {
          $braces-- if $braces;
          push(@toks, $tok);
        }
        elsif (!$braces && $tok->equals(T_OTHER('['))) {
          $depth++;
          push(@toks, $tok);
        }
        elsif (!$braces && $tok->equals(T_OTHER(']'))) {
          if ($depth > 0) {
            $depth--;
            push(@toks, $tok);
          }
          else {
            $closed = 1;
            last;
          }
        }
        else {
          push(@toks, $tok);
        }
      }
      Error('expected', 'tikzcd-options-end', undef, 'Unterminated tikz-cd options') unless $closed;
      return Tokens(@toks);
    }
    return;
}, optional => 1, undigested => 1);

# Define \tikzcd environment / macro
# Syntax: \begin{tikzcd}[<options>] ... \end{tikzcd}
# The matrix constructors emit XM* and so require math. tikzcd itself is a
# display object and is often used in center/figure without an outer $ or \[.
# Wrap only that text-mode case, and do not use \[ (a numbered equation).
our @TIKZCD_ENSURE_MATH;

DefMacro('\tikzcd OptionalTikzCdOptions', sub {
    my ($gullet, $options) = @_;
    check_tikzcd_layout_options($options);
    my $name = 'tikzcd';
    my @toks = (
      T_CS('\lx@gen@matrix@bindings'), T_BEGIN,
      Explode("name=$name,datameaning=commutative-diagram"),
      T_END,
      T_CS('\lx@tikzcd@bindings'),
      T_CS('\lx@ams@matrix@'), T_BEGIN,
      Explode("name=$name,datameaning=commutative-diagram"),
      T_END,
      T_CS('\lx@begin@alignment')
    );
    if (LookupValue('IN_MATH')) {
      push @TIKZCD_ENSURE_MATH, 0;
    }
    else {
      push @TIKZCD_ENSURE_MATH, 1;
      unshift @toks, T_CS('\lx@begin@inline@math');
    }
    return Tokens(@toks);
});

DefMacro('\endtikzcd', sub {
    my @toks = (T_CS('\lx@end@alignment'), T_CS('\lx@end@gen@matrix'));
    push @toks, T_CS('\\lx@end@inline@math') if pop @TIKZCD_ENSURE_MATH;
    return Tokens(@toks);
});

DefPrimitive('\lx@tikzcd@bindings', sub {
    Let("\\\\", '\lx@alignment@newline@noskip');
    Let('\ar',    '\lx@tikzcd@arrow');
    Let('\arrow', '\lx@tikzcd@arrow');
    # Support \& as alignment separator inside tikzcd when needed
    Let('\&', T_ALIGN);
});

# Arrow constructor for \arrow and \ar
DefConstructor('\lx@tikzcd@arrow OptionalTikzCdOptions', sub {
    my ($document, $opt_toks, %props) = @_;
    my $direction = $props{direction} || 'r';
    my $label_box = $props{label_box};
    my $swap      = $props{swap} || 0;
    my $style     = $props{style};
    my $arrow_cs  = $props{arrow_cs} || '\rightarrow';
    my $arrow_ch  = $props{arrow_char} || "\x{2192}";
    my $meaning   = $props{meaning} || 'rightarrow';

    my %edge_attr = (
      'cd:from'     => $props{edge_from},
      'cd:to'       => $props{edge_to},
      'cd:dir'      => (defined $props{dir} ? $props{dir} : $direction),
      'cd:label'    => (defined $props{label_source} ? $props{label_source} : ''),
      'cd:labelpos' => ($swap ? 'below' : 'above'),
      'cd:style'    => (defined $style && length($style) ? $style : 'plain'),
    );

    # Emit outer arrow application
    my $edge_node = $document->openElement('ltx:XMApp', role => 'ARROW', %edge_attr);
    foreach my $name (qw(label style)) {
      if (!length($edge_attr{"cd:$name"})) {
        $edge_node->setAttributeNS(
          'http://dlmf.nist.gov/LaTeXML/cd', "cd:$name", ''); } }

    if (defined $label_box) {
      my $label_role = $swap ? 'SUBSCRIPTOP' : 'SUPERSCRIPTOP';
      $document->openElement('ltx:XMApp', role => 'ARROW');
      $document->insertElement('ltx:XMTok', undef, role => $label_role, scriptpos => 'mid5');
      $document->insertElement('ltx:XMTok', $arrow_ch,
        name     => substr($arrow_cs, 1),
        meaning  => $meaning,
        role     => 'ARROW',
        stretchy => 'true');
      $document->insertElement('ltx:XMArg', $label_box);
      $document->closeElement('ltx:XMApp');
    }
    else {
      # Plain arrow token
      $document->insertElement('ltx:XMTok', $arrow_ch,
        name     => substr($arrow_cs, 1),
        meaning  => $meaning,
        role     => 'ARROW',
        stretchy => 'true');
    }

    $document->closeElement('ltx:XMApp');
  },
  # Revert as the user-level command, so tex= shows tikz-cd syntax and not
  # the internal constructor name. \ar and \arrow both revert as \arrow.
  reversion   => '\arrow[#1]',
  afterDigest => sub {
    my ($stomach, $whatsit) = @_;
    my $opt_toks = $whatsit->getArg(1);
    my %parsed = parse_tikzcd_arrow_options($opt_toks, $stomach);
    my $alignment = $STATE->lookupValue('Alignment');
    my $origin = ($alignment
      ? join('-', $alignment->currentRowNumber, $alignment->currentColumnNumber)
      : undef);
    my $from = valid_tikzcd_coordinate($parsed{from})
      || valid_tikzcd_coordinate($origin);
    my $to = valid_tikzcd_coordinate($parsed{to})
      || resolve_tikzcd_direction($from, $parsed{direction});
    $parsed{origin} = $origin if defined $origin;
    $parsed{edge_from} = $from if defined $from;
    $parsed{edge_to} = $to if defined $to;
    foreach my $k (keys %parsed) {
      $whatsit->setProperty($k => $parsed{$k});
    }
    return;
  }
);

# xcolor's core named colors. Traced as cd:style; not painted.
our %TIKZCD_COLOR = map { $_ => 1 } qw(
  red green blue cyan magenta yellow
  black gray white darkgray lightgray
  brown lime olive orange pink purple teal violet
);

# Direction map to character and control sequence
our %DIR_MAP = (
  'r'  => { cs => '\rightarrow',     char => "\x{2192}", meaning => 'rightarrow' },
  'l'  => { cs => '\leftarrow',      char => "\x{2190}", meaning => 'leftarrow' },
  'u'  => { cs => '\uparrow',        char => "\x{2191}", meaning => 'uparrow' },
  'd'  => { cs => '\downarrow',      char => "\x{2193}", meaning => 'downarrow' },
  'ur' => { cs => '\nearrow',        char => "\x{2197}", meaning => 'nearrow' },
  'ul' => { cs => '\nwarrow',        char => "\x{2196}", meaning => 'nwarrow' },
  'dr' => { cs => '\searrow',        char => "\x{2198}", meaning => 'searrow' },
  'dl' => { cs => '\swarrow',        char => "\x{2199}", meaning => 'swarrow' },
  'rr' => { cs => '\longrightarrow', char => "\x{27F6}", meaning => 'longrightarrow' },
  'll' => { cs => '\longleftarrow',  char => "\x{27F5}", meaning => 'longleftarrow' },
  'dd' => { cs => '\downarrow',      char => "\x{2193}", meaning => 'downarrow' },
  'uu' => { cs => '\uparrow',        char => "\x{2191}", meaning => 'uparrow' },
);

sub parse_tikzcd_arrow_options {
  my ($opt_toks, $stomach) = @_;
  unless (defined $opt_toks) {
    Error('unsupported', 'tikzcd-arrow-syntax', undef,
      'Use bracket arrow syntax with a direction or numeric target; old brace syntax is unsupported');
    return ();
  }

  my @items = split_token_items($opt_toks);
  my @styles = ();
  my $labels = 0;
  my $has_target = 0;
  my %res = (
    direction => 'r',
    dir       => 'r',
    label_source => '',
    swap      => 0,
  );

  foreach my $item_toks (@items) {
    next unless scalar(@$item_toks);
    my $item_str = ToString(Tokens(@$item_toks));
    $item_str =~ s/^\s+//;
    $item_str =~ s/\s+$//;
    next unless length($item_str);

    # Check for quoted label: "..." or "..."'
    if ($item_str =~ /^\"(.*)\"('?)$/s) {
      Error('unsupported', 'tikzcd-multiple-labels', undef,
        'Multiple labels on one edge are not implemented') if $labels++;
      my $inner_str = $1;
      $res{swap} = 1 if $2 eq "'";
      $res{label_source} = $inner_str;
      # Extract tokens between quotes
      my @label_tok_list = extract_quoted_tokens(@$item_toks);
      if (@label_tok_list) {
        $res{label_box} = $stomach->digest(Tokens(T_BEGIN, T_CS('\scriptstyle'), @label_tok_list, T_END));
      }
      next;
    }

    # Key-value pair
    if ($item_str =~ /^([^=]+)=(.*)$/) {
      my ($k, $v) = ($1, $2);
      $k =~ s/^\s+//; $k =~ s/\s+$//;
      $v =~ s/^\s+//; $v =~ s/\s+$//;
      if ($k eq 'from') { $res{from} = $v; }
      elsif ($k eq 'to') { $res{to} = $v; $has_target = 1; }
      elsif ($k eq 'shift left' || $k eq 'shift right') {
        $res{shift} = "$k=$v";
        push(@styles, "$k=$v"); }
      elsif ($k eq 'bend left' || $k eq 'bend right') {
        $res{bend} = "$k=$v";
        push(@styles, "$k=$v"); }
      else {
        # In the source, labels= is a style for every label, not label text.
        Error('unsupported', 'tikzcd-arrow-option', undef,
          "Unsupported tikz-cd arrow option: $item_str");
      }
      next;
    }

    # Case-sensitive arrow styles must be recognized before other option names
    # are folded to lower case.
    if ($item_str eq 'Rightarrow') {
      $res{meaning} = 'Rightarrow';
      $res{arrow_char} = "\x{21D2}";
      $res{arrow_cs} = '\Rightarrow';
      push(@styles, 'Rightarrow');
      next;
    }
    elsif ($item_str eq 'Leftarrow') {
      $res{meaning} = 'Leftarrow';
      $res{arrow_char} = "\x{21D0}";
      $res{arrow_cs} = '\Leftarrow';
      push(@styles, 'Leftarrow');
      next;
    }
    elsif ($item_str eq 'Leftrightarrow') {
      $res{meaning} = 'Leftrightarrow';
      $res{arrow_char} = "\x{21D4}";
      $res{arrow_cs} = '\Leftrightarrow';
      push(@styles, 'Leftrightarrow');
      next;
    }

    # Direction: any nonempty r/l/u/d chain, including the twelve DIR_MAP keys
    # and aliases such as rd/ru or longer walks (rrdd, rrr). cd:dir keeps the
    # source spelling; routing walks the lowercased steps.
    my $low = lc($item_str);
    if ($low =~ /^[ruld]+$/) {
      $res{direction} = $low;
      $res{dir} = $item_str;
      $has_target = 1;
      next;
    }

    # Only direction shortcuts have the fork's case-folding extension.
    # In particular, source Mapsto is not the ordinary mapsto style.
    if ($item_str ne $low) {
      Error('unsupported', 'tikzcd-arrow-option', undef,
        "Unsupported tikz-cd arrow option: $item_str");
      next;
    }

    # Standalone flags
    if ($low eq 'swap' || $low eq "'") {
      $res{swap} = 1;
    }
    elsif ($low eq 'hook' || $low eq 'hookrightarrow') {
      push(@styles, 'hook');
      $res{meaning} = 'hookrightarrow';
      $res{arrow_char} = "\x{21AA}";
      $res{arrow_cs} = '\hookrightarrow';
    }
    elsif ($low eq "hook'") {
      push(@styles, 'hook-left');
    }
    elsif ($low eq 'tail') {
      push(@styles, 'tail');
    }
    elsif ($low eq 'two heads' || $low eq 'twoheadrightarrow') {
      push(@styles, 'twohead');
      $res{meaning} = 'twoheadrightarrow';
      $res{arrow_char} = "\x{21A0}";
      $res{arrow_cs} = '\twoheadrightarrow';
    }
    elsif ($low eq 'dashed') {
      push(@styles, 'dashed');
    }
    elsif ($low eq 'dash' || $low eq 'no head') {
      push(@styles, 'dash');
      $res{meaning} = 'minus';
      $res{arrow_char} = "-";
      $res{arrow_cs} = '-';
    }
    elsif ($low eq 'equal' || $low eq 'equals') {
      push(@styles, 'equal');
      $res{meaning} = 'equals';
      $res{arrow_char} = "=";
      $res{arrow_cs} = '=';
    }
    elsif ($low eq 'rightarrow') {
      $res{meaning} = 'rightarrow';
      push(@styles, 'rightarrow');
    }
    elsif ($low eq 'leftarrow') {
      $res{meaning} = 'leftarrow';
      $res{arrow_char} = "\x{2190}";
      $res{arrow_cs} = '\leftarrow';
      push(@styles, 'leftarrow');
    }
    elsif ($low eq 'leftrightarrow') {
      $res{meaning} = 'leftrightarrow';
      $res{arrow_char} = "\x{2194}";
      $res{arrow_cs} = '\leftrightarrow';
      push(@styles, 'leftrightarrow');
    }
    elsif ($low eq 'maps to' || $low eq 'mapsto') {
      $res{meaning} = 'mapsto';
      $res{arrow_char} = "\x{21A6}";
      $res{arrow_cs} = '\mapsto';
      push(@styles, 'mapsto');
    }
    elsif ($low eq 'shift left' || $low eq 'shift right') {
      # Package default (shift left=+0.56ex); the flag form is not a no-op.
      $res{shift} = $low;
      push(@styles, $low);
    }
    elsif ($TIKZCD_COLOR{$low}) {
      push(@styles, $low);
    }
    else {
      Error('unsupported', 'tikzcd-arrow-option', undef,
        "Unsupported tikz-cd arrow option: $item_str");
    }
  }

  Error('unsupported', 'tikzcd-target', undef,
    'An explicit supported direction or numeric to= target is required') unless $has_target;
  foreach my $end (qw(from to)) {
    Error('unsupported', 'tikzcd-coordinate', undef,
      "Only positive numeric row-column coordinates are implemented: $end=$res{$end}")
      if defined $res{$end} && !valid_tikzcd_coordinate($res{$end});
  }

  # Assign default direction arrow characters if not overridden by style
  if (!defined $res{arrow_char}) {
    my $info = tikzcd_direction_info($res{direction} || 'r');
    $res{arrow_cs}   = $info->{cs};
    $res{arrow_char} = $info->{char};
    $res{meaning}    = $info->{meaning} unless defined $res{meaning};
  }

  $res{style} = (@styles ? join(',', @styles) : 'plain');

  return %res;
}

sub valid_tikzcd_coordinate {
  my ($coordinate) = @_;
  return unless defined $coordinate;
  $coordinate =~ s/^\s*\{(.*)\}\s*$/$1/s;
  return unless $coordinate =~ /^\s*([1-9][0-9]*)-([1-9][0-9]*)\s*$/;
  return "$1-$2"; }

sub resolve_tikzcd_direction {
  my ($origin, $direction) = @_;
  my $coordinate = valid_tikzcd_coordinate($origin);
  return unless defined $coordinate;
  my ($row, $column) = split('-', $coordinate, 2);
  foreach my $step (split('', ($direction || 'r'))) {
    if    ($step eq 'r') { $column++; }
    elsif ($step eq 'l') { $column--; }
    elsif ($step eq 'u') { $row--; }
    elsif ($step eq 'd') { $row++; }
    else { return; }
  }
  return if $row < 1 || $column < 1;
  return "$row-$column"; }

# Glyph for a direction string. Named DIR_MAP keys keep their existing
# arrows; other r/l/u/d chains use net displacement (rd and dr share searrow;
# rrr is a long right arrow).
sub tikzcd_direction_info {
  my ($direction) = @_;
  return $DIR_MAP{$direction} if $direction && $DIR_MAP{$direction};
  return $DIR_MAP{'r'} unless defined $direction && $direction =~ /^[ruld]+$/;
  my ($row, $col) = (0, 0);
  foreach my $step (split('', $direction)) {
    if    ($step eq 'r') { $col++; }
    elsif ($step eq 'l') { $col--; }
    elsif ($step eq 'u') { $row--; }
    elsif ($step eq 'd') { $row++; }
  }
  my $key = 'r';
  if ($col && $row) {
    $key = ($row < 0 ? 'u' : 'd') . ($col < 0 ? 'l' : 'r');
  }
  elsif ($col) {
    $key = abs($col) >= 2 ? ($col > 0 ? 'rr' : 'll') : ($col > 0 ? 'r' : 'l');
  }
  elsif ($row) {
    $key = abs($row) >= 2 ? ($row > 0 ? 'dd' : 'uu') : ($row > 0 ? 'd' : 'u');
  }
  return $DIR_MAP{$key} || $DIR_MAP{'r'}; }

sub split_token_items {
  my ($tokens) = @_;
  my @toks = $tokens->unlist;
  my @items = ();
  my @cur = ();
  my $depth = 0;
  my $in_quote = 0;

  foreach my $t (@toks) {
    my $s = ToString($t);
    if ($s eq '"') {
      $in_quote = !$in_quote;
      push(@cur, $t);
    }
    elsif (!$in_quote && ($s eq '{' || $s eq '[')) {
      $depth++;
      push(@cur, $t);
    }
    elsif (!$in_quote && ($s eq '}' || $s eq ']')) {
      $depth-- if $depth > 0;
      push(@cur, $t);
    }
    elsif (!$in_quote && $depth == 0 && $s eq ',') {
      push(@items, [@cur]);
      @cur = ();
    }
    else {
      push(@cur, $t);
    }
  }
  push(@items, [@cur]) if @cur;
  return @items;
}

sub extract_quoted_tokens {
  my (@toks) = @_;
  my @res = ();
  my $collecting = 0;

  foreach my $t (@toks) {
    my $s = ToString($t);
    if ($s eq '"') {
      if ($collecting) {
        last;
      }
      else {
        $collecting = 1;
        next;
      }
    }
    push(@res, $t) if $collecting;
  }
  return @res;
}

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
1;
