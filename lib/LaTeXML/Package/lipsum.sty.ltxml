sub _parse_lipsum_range {
  my ($spec, $default_start, $default_end, $max) = @_;
  return ($default_start, $default_end) unless defined $spec && $spec =~ /\S/;
  $spec =~ s/\s+//g;
  if ($spec =~ /^(\d+)-(\d+)$/) {
    return ($1, $2);
  } elsif ($spec =~ /^(\d+)-$/) {
    return ($1, $max);
  } elsif ($spec =~ /^-(\d+)$/) {
    return (1, $1);
  } elsif ($spec =~ /^(\d+)$/) {
    return ($1, $1);
  }
  return ($default_start, $default_end);
}

DefMacro('\lipsum OptionalMatch:* [] []', sub {
  my ($gullet, $star, $par_range, $sent_range) = @_;
  my ($p_start, $p_end) = _parse_lipsum_range(ToString($par_range), 1, 7, scalar(@LIPSUM_PARS));
  my @res_paragraphs = ();
  for (my $p = $p_start; $p <= $p_end; $p++) {
    my $idx = (($p - 1) % scalar(@LIPSUM_PARS));
    my $text = $LIPSUM_PARS[$idx];
    if (defined $sent_range && ToString($sent_range) =~ /\S/) {
      my @sentences = split(/(?<=[.?!])\s+/, $text);
      my ($s_start, $s_end) = _parse_lipsum_range(ToString($sent_range), 1, scalar(@sentences), scalar(@sentences));
      my $from = $s_start - 1;
      my $to = $s_end - 1;
      $from = 0 if $from < 0;
      $to = $#sentences if $to > $#sentences;
      $to = $from if $to < $from;
      $text = join(' ', @sentences[$from .. $to]);
    }
    push(@res_paragraphs, $text);
  }

  if ($star) {
    my $full = join(' ', @res_paragraphs);
    return Explode($full);
  } else {
    my @tokens = ();
    for my $i (0 .. $#res_paragraphs) {
      push(@tokens, T_CS('\par')) if $i > 0;
      push(@tokens, Explode($res_paragraphs[$i]));
    }
    return Tokens(@tokens);
  }
});

DefMacro('\setlipsum{}',              '');
DefMacro('\SetLipsumLanguage{}',      '');
DefMacro('\NewLipsumPar{}',           '');
DefMacro('\SetLipsumDefaultRange{}',  '');
DefMacro('\unpacklipsum[]',           '');

1;
