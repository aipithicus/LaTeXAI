package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# Emulates tcolorbox 6.10.0 (2026-05-28), TeX Live revision 79191.
# Replaces earlier passthrough that loaded raw tcolorbox.sty and pulled in TikZ/PGF.
# Severed dependencies: tikz, pgf, pgfkeys, environ. Native etoolbox supplies environment hooks.

RequirePackage('xcolor');
RequirePackage('etoolbox');

DeclareOption(undef, sub { });
ProcessOptions();

NewCounter('tcbcounter');
DefMacro('\thetcbcounter', '\arabic{tcbcounter}');

# Legacy / safety registers and macros
DefRegister('\doublecol@number' => Number(0));
DefMacro('\tcb@init@breakable',   '\relax');
DefMacro('\tcb@init@unbreakable', '\relax');
DefMacro('\tcb@use@autoparskip',  '\relax');

# Library loader (severed: native implementation provides built-in support)
DefPrimitive('\tcbuselibrary{}', sub { return; });

# Key-value options for tcolorbox
my @tcb_keys = qw(
  title adjusted_title subtitle
  colback colframe coltext coltitle colbacktitle colupper collower
  fonttitle fontupper fontlower
  width arc boxrule boxsep left right top bottom middle
  sharp_corners rounded_corners enhanced standard blank empty
  breakable unbreakable
  halign valign center flush_left flush_right
  label nameref
  before after before_upper after_upper before_lower after_lower
  opacityback opacityframe opacitytitle
  auto_counter no_counter use_counter number_within
  listing_only listing_options listing_engine listing_file
  before_skip after_skip enhanced_jigsaw
);

my %flag_keys = map { $_ => 1 } qw(
  sharp_corners rounded_corners enhanced standard blank empty
  breakable unbreakable
  center flush_left flush_right
  auto_counter no_counter listing_only enhanced_jigsaw
);

foreach my $key (@tcb_keys) {
  my $k = $key;
  $k =~ s/_/ /g;
  my $default = $flag_keys{$key} ? 'true' : undef;
  DefKeyVal('tcb', $k, 'Undigested', $default);
}

AssignValue('tcb_defaults', {});

sub _tcb_read_keys {
  my ($gullet,$tokens,$family)=@_;
  my $kv=LaTeXML::Core::KeyVals->new('KV',$family||'tcb');
  $gullet->readingFromMouth(Tokens(T_BEGIN,$tokens,T_END),sub {$kv->readFrom($_[0],T_END);});
  return $kv;
}
sub _tcb_options {
  my ($gullet,$base,$kv,$seen)=@_;
  my %values=%$base;
  return \%values unless $kv;
  my @pairs=$kv->getPairs;
  while (@pairs) {
    my ($key,$value)=splice(@pairs,0,2);
    if ($key =~ m{^(.*)/\.style$}) {
      AssignValue('tcb_style:'.$1,$value);
      DefKeyVal('tcb',$1,'Undigested','');
    }
    elsif (my $style=LookupValue('tcb_style:'.$key)) {
      if ($seen->{$key}) { Error('unsupported','tcolorbox-style',$gullet,"Recursive tcolorbox style '$key'");next; }
      %values=%{_tcb_options($gullet,\%values,_tcb_read_keys($gullet,$style),{%$seen,$key=>1})};
    }
    else {$values{$key}=$value;}
  }
  return \%values;
}
DefPrimitive('\tcbset RequiredKeyVals:tcb',sub {
  AssignValue('tcb_defaults',_tcb_options($_[0]->getGullet,LookupValue('tcb_defaults')||{},$_[1],{}));
});
DefPrimitive('\tcbsetforevery RequiredKeyVals:tcb',sub {
  AssignValue('tcb_defaults',_tcb_options($_[0]->getGullet,LookupValue('tcb_defaults')||{},$_[1],{}),'global');
});

sub _tcb_color {
  my ($spec) = @_;
  return unless defined $spec;
  my $s = ToString($spec);
  $s =~ s/^\s+|\s+$//g;
  return unless length $s;
  my $color = DecodeColor($s);
  return $color if $color;
  return $s;
}

DefConstructor('\lx@tcb@title{}',
  "<ltx:block class='ltx_tcolorbox_title'>"
  . "<ltx:p class='ltx_tcolorbox_title_text'>#1</ltx:p>"
  . "</ltx:block>");

# logical-block cannot carry labels (not a Labelled element); theorem can.
# Titled/labelled callouts are theorems with class ltx_tcolorbox.
DefEnvironment('{tcolorbox} OptionalKeyVals:tcb',
  "<ltx:theorem class='ltx_tcolorbox'"
    . " ?#id(xml:id='#id')"
    . " ?#framed(framed='#framed')"
    . " ?#backgroundcolor(backgroundcolor='#backgroundcolor')"
    . " ?#framecolor(framecolor='#framecolor')"
    . " ?#width(width='#width')"
    . " ?#labels(labels='#labels')>"
    . "#body"
    . "</ltx:theorem>",
  beforeConstruct => sub {
    my ($document,$whatsit)=@_;
    $document->maybeCloseElement('ltx:p');
    $whatsit->setProperty(tcb_float_wrapper=>0);
    # Figures/tables admit physical blocks, whereas this labelled box owns
    # logical paragraphs. An existing inline-logical-block bridges the models
    # without moving the box label to the float or changing the schema.
    my $parent=$document->getNodeQName($document->getNode);
    if ($parent =~ /^ltx:(?:figure|table|float)$/) {
      $document->openElement('ltx:inline-logical-block',class=>'ltx_tcolorbox_float');
      $whatsit->setProperty(tcb_float_wrapper=>1);
    }
  },
  afterConstruct => sub {
    my ($document,$whatsit)=@_;
    $document->closeElement('ltx:inline-logical-block') if $whatsit->getProperty('tcb_float_wrapper');
  },
  afterDigestBegin => sub {
    my ($stomach, $whatsit) = @_;
    my $v=_tcb_options($stomach->getGullet,LookupValue('tcb_defaults')||{},$whatsit->getArg(1),{});
    my @boxes;
    StepCounter('tcbcounter') if $v->{'auto counter'};
    push @boxes,Digest(Invocation(T_CS('\lx@tcb@title'),$v->{title})) if $v->{title};
    Digest(Invocation(T_CS('\color'),undef,$v->{coltext})) if $v->{coltext};
    push @boxes,Digest($v->{fontupper}) if $v->{fontupper};
    push @boxes,Digest($v->{'before upper'}) if $v->{'before upper'};
    return @boxes;
  },
  properties => sub {
    my ($stomach, $kv) = @_;
    my $defaults = _tcb_options($stomach->getGullet,LookupValue('tcb_defaults')||{},$kv,{});
    my %props = (class => 'ltx_tcolorbox', framed => 'rectangle');

    my $cb = $defaults->{colback};
    $props{backgroundcolor} = _tcb_color($cb) if $cb;

    my $cf = $defaults->{colframe};
    $props{framecolor} = _tcb_color($cf) if $cf;

    my $w = $defaults->{width};
    $props{width} = $w if $w;

    # Attach the label on the box itself. Digesting \label floats to the
    # nearest labelled ancestor (the section), because logical-block has
    # no xml:id yet.
    if (my $lbl = $defaults->{label}) {
      $props{labels} = CleanLabel(ToString($lbl));
      MaybeNoteLabel($lbl);
    }

    return %props;
  },
  mode => 'internal_vertical'
);

DefConstructor('\tcbox OptionalKeyVals:tcb {}',
  "<ltx:text class='ltx_tcbox' ?#framed(framed='#framed') ?#framecolor(framecolor='#framecolor') ?#backgroundcolor(backgroundcolor='#backgroundcolor')>#2</ltx:text>",
  properties => sub {
    my ($stomach, $kv, $content) = @_;
    my $defaults = _tcb_options($stomach->getGullet,LookupValue('tcb_defaults')||{},$kv,{});
    my %props = (framed => 'rectangle');

    my $cb = $defaults->{colback};
    $props{backgroundcolor} = _tcb_color($cb) if $cb;

    my $cf = $defaults->{colframe};
    $props{framecolor} = _tcb_color($cf) if $cf;

    return %props;
  }
);

DefConstructor('\tcblower',
  "<ltx:block class='ltx_tcolorbox_separator'/>");

# Environment creation: \newtcolorbox and variants
DefPrimitive('\newtcolorbox [] {} [Number] [] {}', sub {
  my ($stomach, $init, $name, $nargs, $default, $options) = @_;
  $name = ToString(Expand($name));
  $name =~ s/^\\//;
  my $begin = Tokens(T_CS('\begin{tcolorbox}'), T_OTHER('['), ($options ? $options->unlist : ()), T_OTHER(']'));
  my $end   = Tokens(T_CS('\end{tcolorbox}'));
  DefMacroI(T_CS("\\$name"), convertLaTeXArgs($nargs, $default), $begin);
  DefMacroI(T_CS("\\end$name"), undef, $end);
  return;
});

DefPrimitive('\renewtcolorbox [] {} [Number] [] {}', sub {
  Digest(Invocation(T_CS('\newtcolorbox'), $_[1], $_[2], $_[3], $_[4], $_[5]));
});
Let('\NewTColorBox',     '\newtcolorbox');
Let('\RenewTColorBox',   '\renewtcolorbox');
Let('\ProvideTColorBox', '\newtcolorbox');
Let('\DeclareTColorBox', '\newtcolorbox');

# Inline box creation: \newtcbox and variants
DefPrimitive('\newtcbox [] Undigested [Number] [] {}', sub {
  my ($stomach, $init, $name, $nargs, $default, $options) = @_;
  my $str = $name ? join('', map { $_->getString } $name->unlist) : '';
  $str =~ s/^\\//;
  my $cs = T_CS('\\' . $str);
  my $n = $nargs ? $nargs->valueOf : 0;
  if ($n == 0) {
    DefMacroI($cs, undef, Tokens(T_CS('\tcbox'), T_OTHER('['), ($options ? $options->unlist : ()), T_OTHER(']')));
  } else {
    my $expansion = Tokens(T_CS('\tcbox'), T_OTHER('['), ($options ? $options->unlist : ()), T_OTHER(']'), T_BEGIN, Tokens(T_PARAM, T_OTHER(ToString($n))), T_END);
    DefMacroI($cs, convertLaTeXArgs($nargs, $default), $expansion);
  }
  return;
});

DefPrimitive('\renewtcbox [] Undigested [Number] [] {}', sub {
  Digest(Invocation(T_CS('\newtcbox'), $_[1], $_[2], $_[3], $_[4], $_[5]));
});
Let('\NewTCBox',     '\newtcbox');
Let('\RenewTCBox',   '\renewtcbox');
Let('\ProvideTCBox', '\newtcbox');
Let('\DeclareTCBox', '\newtcbox');

# Theorems: \newtcbtheorem and variants
DefPrimitive('\newtcbtheorem [] {} {} {} {}', sub {
  my ($stomach, $init, $name, $title, $options, $prefix) = @_;
  $name   = ToString(Expand($name));
  $name   =~ s/^\\//;
  $title  = ToString(Expand($title));
  $prefix = ToString(Expand($prefix));
  my $ctr = 'tcb@cnt@' . $name;
  NewCounter($ctr, undef);

  # Unstarred environment: [keyvals]{SubTitle}{Label}
  DefMacroI(T_CS("\\$name"), "OptionalKeyVals:tcb {}{}", sub {
    my ($gullet, $extra, $subtitle, $label) = @_;
    StepCounter($ctr);
    DefMacroI('\thetcbcounter', undef, Tokens(Explode(CounterValue($ctr)->valueOf)));
    my $num = CounterValue($ctr)->valueOf;
    my $t = Tokens(Tokenize($title . ' ' . $num . ': '), ($subtitle ? $subtitle->unlist : ()));
    my $lbl = Tokens(Tokenize($prefix . ':'), ($label ? $label->unlist : ()));
    my @opt = ($options ? $options->unlist : ());
    if ($extra) {
      push(@opt, T_OTHER(','), $extra->revert);
    }
    return Tokens(
      T_CS('\begin{tcolorbox}'),
      T_OTHER('['),
      @opt,
      T_OTHER(','),
      Tokenize('title='), T_BEGIN, $t->unlist, T_END,
      T_OTHER(','),
      Tokenize('label='), T_BEGIN, $lbl->unlist, T_END,
      T_OTHER(']')
    );
  });
  DefMacroI(T_CS("\\end$name"), undef, Tokens(T_CS('\end{tcolorbox}')));

  # Starred environment: [keyvals]{SubTitle}
  DefMacroI(T_CS("\\$name*"), "OptionalKeyVals:tcb {}", sub {
    my ($gullet, $extra, $subtitle) = @_;
    my $t = Tokens(Tokenize($title . ': '), ($subtitle ? $subtitle->unlist : ()));
    my @opt = ($options ? $options->unlist : ());
    if ($extra) {
      push(@opt, T_OTHER(','), $extra->revert);
    }
    return Tokens(
      T_CS('\begin{tcolorbox}'),
      T_OTHER('['),
      @opt,
      T_OTHER(','),
      Tokenize('title='), T_BEGIN, $t->unlist, T_END,
      T_OTHER(']')
    );
  });
  DefMacroI(T_CS("\\end$name*"), undef, Tokens(T_CS('\end{tcolorbox}')));
  return;
});

DefPrimitive('\renewtcbtheorem [] {} {} {} {}', sub {
  Digest(Invocation(T_CS('\newtcbtheorem'), $_[1], $_[2], $_[3], $_[4], $_[5]));
});
Let('\NewTcbTheorem',     '\newtcbtheorem');
Let('\RenewTcbTheorem',   '\renewtcbtheorem');
Let('\ProvideTcbTheorem', '\newtcbtheorem');
Let('\DeclareTcbTheorem', '\newtcbtheorem');

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# tcolorbox 6.10.0 env/<name>/before and /after hooks. Existing theorem
# constructors retain ownership of their counter, title, labels and references.
DefMacro('\tcolorboxenvironment {} {}',
  '\BeforeBeginEnvironment{#1}{\begin{tcolorbox}[#2]}\AfterEndEnvironment{#1}{\end{tcolorbox}}');

sub _tcb_listing {
  my ($gullet,$options,$environment)=@_;
  RequirePackage('listings');
  my $v=_tcb_options($gullet,LookupValue('tcb_defaults')||{},_tcb_read_keys($gullet,$options),{});
  # Read even unsupported modes as literal residue; never execute listing text.
  my $text=$environment ? listingsReadRawLines($gullet,$environment)
    : listingsReadRawFile($gullet,$v->{'listing file'});
  if (!exists($v->{'listing only'}) || ($v->{'listing engine'} && ToString($v->{'listing engine'}) ne 'listings')) {
    Error('unsupported','tcolorbox-listing-mode',$gullet,'Only listing-only mode with the listings engine is supported');
  }
  $STATE->getStomach->bgroup;
  my $lstkv=$v->{'listing options'} ? _tcb_read_keys($gullet,$v->{'listing options'},'LST') : undef;
  lstActivate($lstkv);
  for my $key (qw(caption title label)) {
    Error('unsupported','tcolorbox-listing-caption',$gullet,'Use tcolorbox title/label outside listing options')
      if $lstkv && $lstkv->getValue($key);
  }
  my ($body,$trailer)=lstProcessBlock(undef,$text);
  pop @$trailer; # The group opened above must close AFTER the enclosing box.
  return (T_CS('\begin{tcolorbox}'),T_OTHER('['),$options,T_OTHER(']'),
    @$body,@$trailer,T_CS('\end{tcolorbox}'),T_END);
}
DefPrimitive('\newtcblisting [] {} [Number] [] DefPlain',sub {
  my ($stomach,$init,$name,$nargs,$default,$options)=@_;
  $name=ToString($name);
  Error('unsupported','tcolorbox-listing-init',$stomach,'Listing initialization options are unsupported') if $init && !IsEmpty($init);
  if (IsDefined(T_CS('\\begin{'.$name.'}')) || IsDefined(T_CS('\\'.$name))) {
    Error('unexpected','tcolorbox-listing-environment',$stomach,"Environment '$name' already exists");return;
  }
  # Keep a same-line optional argument from peeking into the literal body.
  # The listings reader discards the remainder of the begin line.
  DefMacroI(T_CS('\\begin{'.$name.'}'),undef,sub {
    my ($gullet)=@_;my @args;
    my $count=$nargs?$nargs->valueOf:0;
    for my $i (1..$count) {
      if ($i==1 && defined $default) {
        my $cat=$STATE->lookupCatcode("\r");AssignCatcode("\r",CC_OTHER);
        push @args,$gullet->readOptional($default);AssignCatcode("\r",$cat);
      }
      else {push @args,$gullet->readArg;}
    }
    return _tcb_listing($gullet,$options->substituteParameters(@args),$name);
  });
});
DefMacro('\tcbinputlisting {}',sub {return _tcb_listing($_[0],$_[1],undef);});

1;
