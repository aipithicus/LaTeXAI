# Native stub replacing InputDefinitions('pgfkeys.code'). Absorbs the
# public pgfkeys surface without executing raw PGF or installing the
# key tree. Unknown keys are not errors. Written for the TikZ containment
# envelope; not a pgfkeys interpreter.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

DeclareOption(undef, sub { });
ProcessOptions();

DefMacro('\pgfkeys{}',          '');
DefMacro('\pgfqkeys{}{}',       '');
DefMacro('\pgfkeysalso{}',      '');
DefMacro('\pgfqkeysalso{}{}',   '');
DefMacro('\pgfkeyssetvalue{}{}', '');
DefMacro('\pgfkeysaddvalue{}{}{}', '');
DefMacro('\pgfkeyslet{}{}',     '');
DefMacro('\pgfkeysgetvalue{}{}', '');
DefMacro('\pgfkeysvalueof{}',   '');
DefMacro('\pgfkeysifdefined{}{}{}', '#3');
DefMacro('\pgfkeysifassignable{}{}{}', '#3');
DefMacro('\pgfkeys@split{}{}{}', '');
DefMacro('\pgfkeysdef{}{}',     '');
DefMacro('\pgfkeysedef{}{}',    '');
DefMacro('\pgfkeysdefnargs{}{}{}', '');
DefMacro('\pgfkeysedefnargs{}{}{}', '');

1;
