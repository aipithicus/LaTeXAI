package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# CTAN: cleveref v0.21.4 (rev 79618)
# Pure native binding eliminating InputDefinitions('cleveref').

Let(T_CS('\lx@cleverref@save@label'), T_CS('\label'));
DefMacro('\lx@cleverref@label[]', '\lx@cleverref@save@label');
AtBeginDocument(sub {
    Let(T_CS('\label'), T_CS('\lx@cleverref@label')); });

# Default English conjunctions
DefMacro('\crefrangeconjunction',        '\space to\nobreakspace');
DefMacro('\crefrangepreconjunction',    '');
DefMacro('\crefrangepostconjunction',   '');
DefMacro('\crefpairconjunction',        '\space and\nobreakspace');
DefMacro('\crefmiddleconjunction',      ',\space');
DefMacro('\creflastconjunction',        '\space and\nobreakspace');
DefMacro('\crefpairgroupconjunction',   '\space and\nobreakspace');
DefMacro('\crefmiddlegroupconjunction', ',\space');
DefMacro('\creflastgroupconjunction',   ',\space and\nobreakspace');

# Register default English type names
sub def_cref_type {
  my ($type, $sing, $plur, $cap_sing, $cap_plur) = @_;
  DefMacro('\cref@' . $type . '@name',             $sing);
  DefMacro('\cref@' . $type . '@name@plural',      $plur);
  DefMacro('\Cref@' . $type . '@name',             $cap_sing);
  DefMacro('\Cref@' . $type . '@name@plural',      $cap_plur);
}

def_cref_type('equation',          'eq.',        'eqs.',         'Equation',    'Equations');
def_cref_type('figure',            'fig.',       'figs.',        'Figure',      'Figures');
def_cref_type('subfigure',         'fig.',       'figs.',        'Figure',      'Figures');
def_cref_type('table',             'table',      'tables',       'Table',       'Tables');
def_cref_type('subtable',          'table',      'tables',       'Table',       'Tables');
def_cref_type('page',              'page',       'pages',        'Page',        'Pages');
def_cref_type('part',              'part',       'parts',        'Part',        'Parts');
def_cref_type('chapter',           'chapter',    'chapters',     'Chapter',     'Chapters');
def_cref_type('section',           'section',    'sections',     'Section',     'Sections');
def_cref_type('subsection',        'section',    'sections',     'Section',     'Sections');
def_cref_type('subsubsection',     'section',    'sections',     'Section',     'Sections');
def_cref_type('paragraph',         'paragraph',  'paragraphs',   'Paragraph',   'Paragraphs');
def_cref_type('subparagraph',      'paragraph',  'paragraphs',   'Paragraph',   'Paragraphs');
def_cref_type('appendix',          'appendix',   'appendices',   'Appendix',    'Appendices');
def_cref_type('subappendix',       'appendix',   'appendices',   'Appendix',    'Appendices');
def_cref_type('subsubappendix',    'appendix',   'appendices',   'Appendix',    'Appendices');
def_cref_type('subsubsubappendix', 'appendix',   'appendices',   'Appendix',    'Appendices');
def_cref_type('enumi',             'item',       'items',        'Item',        'Items');
def_cref_type('enumii',            'item',       'items',        'Item',        'Items');
def_cref_type('enumiii',           'item',       'items',        'Item',        'Items');
def_cref_type('enumiv',            'item',       'items',        'Item',        'Items');
def_cref_type('enumv',             'item',       'items',        'Item',        'Items');
def_cref_type('footnote',          'footnote',   'footnotes',    'Footnote',    'Footnotes');
def_cref_type('theorem',           'theorem',    'theorems',     'Theorem',     'Theorems');
def_cref_type('lemma',             'lemma',      'lemmas',       'Lemma',       'Lemmas');
def_cref_type('corollary',         'corollary',  'corollaries',  'Corollary',   'Corollaries');
def_cref_type('proposition',       'proposition','propositions', 'Proposition', 'Propositions');
def_cref_type('definition',        'definition', 'definitions',  'Definition',  'Definitions');
def_cref_type('result',            'result',     'results',      'Result',      'Results');
def_cref_type('example',           'example',    'examples',     'Example',     'Examples');
def_cref_type('remark',            'remark',     'remarks',      'Remark',      'Remarks');
def_cref_type('note',              'note',       'notes',        'Note',        'Notes');
def_cref_type('algorithm',         'algorithm',  'algorithms',   'Algorithm',   'Algorithms');
def_cref_type('listing',           'listing',    'listings',     'Listing',     'Listings');
def_cref_type('line',              'line',       'lines',        'Line',        'Lines');

# Options
DeclareOption('capitalize', sub {
  AssignValue('cleveref_capitalise' => 1);
});
DeclareOption('capitalise', sub {
  AssignValue('cleveref_capitalise' => 1);
});
DeclareOption('noabbrev', sub {
  def_cref_type('equation',  'equation', 'equations', 'Equation', 'Equations');
  def_cref_type('figure',    'figure',   'figures',   'Figure',   'Figures');
  def_cref_type('subfigure', 'figure',   'figures',   'Figure',   'Figures');
});
DeclareOption('nameinlink', sub {
  AssignValue('cleveref_nameinlink' => 1);
});
# Furniture: sorting/compression and language files have no IR effect.
foreach my $opt (qw(sort compress nosort nocompress
  english american british german ngerman french spanish italian
  dutch russian ukrainian norwegian nynorsk danish swedish finnish)) {
  DeclareOption($opt, sub { });
}
DeclareOption(undef, sub { });

ProcessOptions();

sub _cref_capitalize {
  my ($tokens) = @_;
  return $tokens unless $tokens;
  my $s = ToString($tokens);
  $s =~ s/^\s+|\s+$//g;
  return $tokens unless length $s;
  substr($s, 0, 1) = uc(substr($s, 0, 1));
  return TokenizeInternal($s);
}

# User-facing customizers
DefMacro('\crefname{}{}{}', sub {
  my ($gullet, $type, $sing, $plur) = @_;
  my $t = ToString($type);
  DefMacro('\cref@' . $t . '@name',        $sing);
  DefMacro('\cref@' . $t . '@name@plural', $plur);
  # Real cleveref derives \Crefname from \crefname when the user omits it.
  DefMacro('\Cref@' . $t . '@name',        _cref_capitalize($sing));
  DefMacro('\Cref@' . $t . '@name@plural', _cref_capitalize($plur));
  return ();
});

DefMacro('\Crefname{}{}{}', sub {
  my ($gullet, $type, $sing, $plur) = @_;
  my $t = ToString($type);
  DefMacro('\Cref@' . $t . '@name',        $sing);
  DefMacro('\Cref@' . $t . '@name@plural', $plur);
  return ();
});

DefMacro('\crefalias{}{}', sub {
  my ($gullet, $counter, $type) = @_;
  DefMacro('\cref@' . ToString($counter) . '@alias', ToString($type));
  return ();
});

DefMacro('\crefformat{}{}');
DefMacro('\Crefformat{}{}');
DefMacro('\crefrangeformat{}{}');
DefMacro('\Crefrangeformat{}{}');
DefMacro('\crefmultiformat{}{}{}{}{}');
DefMacro('\Crefmultiformat{}{}{}{}{}');
DefMacro('\crefrangemultiformat{}{}{}{}{}');
DefMacro('\Crefrangemultiformat{}{}{}{}{}');
DefMacro('\crefdefaultlabelformat{}');

sub splitLabels {
  my ($labels) = @_;
  return split(/\s*,\s*/, ToString($labels));
}

sub crefMulti {
  my ($starred, $labels, $showtype, $capitalized) = @_;
  my @labels = splitLabels($labels);
  if (scalar(@labels) < 2) {
    return Invocation(T_CS('\lx@cref'),
      $starred,
      T_OTHER($showtype
        ? ($capitalized
          ? "creftypecap~refnum"
          : "creftype~refnum")
        : "refnum"),
      $labels[0]); }
  else {
    my @tokens = (Invocation(T_CS('\lx@cref'),
        $starred,
        T_OTHER($showtype
          ? ($capitalized
            ? "creftypepluralcap~refnum"
            : "creftypeplural~refnum")
          : "refnum"),
        shift(@labels)));
    if (scalar(@labels == 1)) {
      push(@tokens, T_CS('\crefpairconjunction'),
        Invocation(T_CS('\lx@cref'), $starred, T_OTHER('refnum'), $labels[0])); }
    else {
      while (scalar(@labels) > 1) {
        push(@tokens, T_CS('\crefmiddleconjunction'),
          Invocation(T_CS('\lx@cref'), $starred, T_OTHER('refnum'), shift(@labels))); }
      push(@tokens, T_CS('\creflastconjunction'),
        Invocation(T_CS('\lx@cref'), $starred, T_OTHER('refnum'), shift(@labels))); }
    return @tokens; } }

DefConstructor('\lx@cref OptionalMatch:* HyperVerbatim Semiverbatim',
  "<ltx:ref labelref='#label' show='#2' ?#1(class='ltx_nolink')() _force_font='true'/>",
  enterHorizontal => 1,
  properties      => sub { (label => CleanLabel($_[3])); });

DefMacro('\cref OptionalMatch:* Semiverbatim', sub {
  my $cap = LookupValue('cleveref_capitalise') ? 1 : 0;
  crefMulti($_[1], $_[2], 1, $cap);
});

DefMacro('\Cref OptionalMatch:* Semiverbatim', sub {
  crefMulti($_[1], $_[2], 1, 1);
});

DefMacro('\crefrange OptionalMatch:* Semiverbatim Semiverbatim',
  '\lx@cref#1{creftypeplural~refnum}{#2}\crefrangeconjunction\ref{#3}');

DefMacro('\Crefrange OptionalMatch:* Semiverbatim Semiverbatim',
  '\lx@cref#1{creftypepluralcap~refnum}{#2}\crefrangeconjunction\ref{#3}');

DefMacro('\cpageref OptionalMatch:* Semiverbatim', sub {
  my $cap = LookupValue('cleveref_capitalise') ? 1 : 0;
  crefMulti($_[1], $_[2], 1, $cap);
});

DefMacro('\Cpageref OptionalMatch:* Semiverbatim', sub {
  crefMulti($_[1], $_[2], 1, 1);
});

DefMacro('\cpagerefrange OptionalMatch:* Semiverbatim Semiverbatim',
  '\lx@cref#1{creftype~refnum}{#2}\crefrangeconjunction\lx@cref#1{creftype~refnum}{#3}');
DefMacro('\Cpagerefrange OptionalMatch:* Semiverbatim Semiverbatim',
  '\lx@cref#1{creftypecap~refnum}{#2}\crefrangeconjunction\lx@cref#1{creftype~refnum}{#3}');

DefMacro('\namecref Semiverbatim',    '\lx@cref{creftype}{#1}');
DefMacro('\nameCref Semiverbatim',    '\lx@cref{creftypecap}{#1}');
DefMacro('\namecrefs Semiverbatim',   '\lx@cref{creftypeplural}{#1}');
DefMacro('\nameCrefs Semiverbatim',   '\lx@cref{creftypepluralcap}{#1}');
DefMacro('\lcnamecref Semiverbatim',  '\lx@cref{creftype}{#1}');
DefMacro('\lcnamecrefs Semiverbatim', '\lx@cref{creftypeplural}{#1}');

DefMacro('\labelcref Semiverbatim',     sub { crefMulti(undef, $_[1], 0, 0); });
DefMacro('\labelcpageref Semiverbatim', sub { crefMulti(undef, $_[1], 0, 0); });

#======================================================================
sub crefType {
  my $type = ToString($_[0]);
  my $acs  = T_CS('\cref@' . $type . '@alias');
  return (LookupDefinition($acs) ? ToString(Expand($acs)) : $type);
}

DefMacro('\lx@cleverrefnum@@{}', sub {
    my $cs = T_CS('\cref@' . crefType($_[1]) . '@name');
    return Tokens((LookupDefinition($cs) ? $cs : ())); });
DefMacro('\lx@cleverrefnumplural@@{}', sub {
    my $cs = T_CS('\cref@' . crefType($_[1]) . '@name@plural');
    return Tokens((LookupDefinition($cs) ? $cs : ())); });
DefMacro('\lx@cleverrefnumcap@@{}', sub {
    my $cs = T_CS('\Cref@' . crefType($_[1]) . '@name');
    return Tokens((LookupDefinition($cs) ? $cs : ())); });
DefMacro('\lx@cleverrefnumpluralcap@@{}', sub {
    my $cs = T_CS('\Cref@' . crefType($_[1]) . '@name@plural');
    return Tokens((LookupDefinition($cs) ? $cs : ())); });

AssignMapping('type_tag_formatter', 'creftype'          => '\lx@cleverrefnum@@');
AssignMapping('type_tag_formatter', 'creftypeplural'    => '\lx@cleverrefnumplural@@');
AssignMapping('type_tag_formatter', 'creftypecap'       => '\lx@cleverrefnumcap@@');
AssignMapping('type_tag_formatter', 'creftypepluralcap' => '\lx@cleverrefnumpluralcap@@');

#======================================================================
1;
