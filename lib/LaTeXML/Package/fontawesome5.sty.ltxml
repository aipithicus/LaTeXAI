DefMacro('\faIcon[]{}', sub {
    my ($gullet, $style, $name) = @_;
    my $st = ToString($style);
    $st = 'solid' unless $st;
    $st = 'solid' unless $st eq 'regular' || $st eq 'solid';
    my $id = ToString($name);
    my $ch = $FA_ICONS{$id};
    return () unless defined $ch;
    return Invocation(T_CS('\lx@fa@icon'), T_OTHER($st), Tokenize($ch)); });

1;
