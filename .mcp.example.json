{
    "_comment": "Copy to .mcp.json (gitignored), replace placeholders, and follow docs/recipes/powershell-workflows.md. Remove PERL_ROOT/CDXSCI_ROOT env entries to use scripts/local.psd1. Long work uses start/wait.",
    "mcpServers": {
        "nushell": {
            "command": "<SCIENCE_FACILITY>/mcp/nushell-mcp/deps/nushell/nu.exe",
            "args": [
                "--mcp",
                "--config",
                "<SCIENCE_FACILITY>/mcp/nushell-mcp/config.nu"
            ],
            "env": {
                "NU_MCP_OUTPUT_LIMIT": "20kb",
                "NO_COLOR": "1",
                "NU_LOG_LEVEL": "warn"
            }
        },
        "pwsh_exec": {
            "command": "<SCIENCE_FACILITY>/mcp/pwsh_exec/deps/python/cpython-<version>-windows-x86_64-none/python.exe",
            "args": [
                "-B",
                "<SCIENCE_FACILITY>/mcp/pwsh_exec/server.py"
            ],
            "env": {
                "MCP_POWERSHELL_EXECUTABLE": "<SCIENCE_FACILITY>/mcp/pwsh_exec/deps/bin/pwsh/pwsh.exe",
                "MCP_POWERSHELL_PROFILE": "<LATEXAI_ROOT>/scripts/profile.ps1",
                "PERL_ROOT": "<PERL_ROOT>",
                "CDXSCI_ROOT": "<CDXSCI_ROOT>"
            }
        },
        "mdnav": {
            "command": "node",
            "args": [
                "<SCIENCE_FACILITY>/mcp/mdnav/src/index.ts"
            ]
        }
    }
}
