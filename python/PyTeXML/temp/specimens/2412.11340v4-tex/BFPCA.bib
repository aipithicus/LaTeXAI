@article{shepard_representation_2015,
	title = {The {Representation} and {Parametrization} of {Orthogonal} {Matrices}},
	volume = {119},
	issn = {1089-5639},
	url = {https://doi.org/10.1021/acs.jpca.5b02015},
	doi = {10.1021/acs.jpca.5b02015},
	abstract = {Four representations and parametrizations of orthogonal matrices Q∈Rm × n in terms of the minimal number of essential parameters \{φ\} are discussed: the exponential representation, the Householder reflector representation, the Givens rotation representation, and the rational Cayley transform representation. Both square n = m and rectangular n {\textless} m situations are considered. Two separate kinds of parametrizations are considered: one in which the individual columns of Q are distinct, the Stiefel manifold, and the other in which only span(Q) is significant, the Grassmann manifold. The practical issues of numerical stability, continuity, and uniqueness are discussed. The computation of Q in terms of the essential parameters \{φ\}, and also the extraction of \{φ\} for a given Q are considered for all of the parametrizations. The transformation of gradient arrays between the Q and \{φ\} variables is discussed for all representations. It is our hope that developers of new methods will benefit from this comparative presentation of an important but rarely analyzed subject.},
	number = {28},
	urldate = {2024-12-13},
	journal = {The Journal of Physical Chemistry A},
	author = {Shepard, Ron and Brozell, Scott R. and Gidofalvi, Gergely},
	month = jul,
	year = {2015},
	note = {Publisher: American Chemical Society},
	pages = {7924--7939},
}

