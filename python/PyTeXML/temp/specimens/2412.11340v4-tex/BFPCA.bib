}

@article{shi_analysis_1996,
	title = {An {Analysis} of {Paediatric} {CD4} {Counts} for {Acquired} {Immune} {Deficiency} {Syndrome} {Using} {Flexible} {Random} {Curves}},
	volume = {45},
