{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "conditions",
    "comparisons",
    "measurement"
  ],
  "properties": {
    "schema": {
      "const": "latexai/paper-experiment/1"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "engine",
          "execution",
          "outputs",
          "counts",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "ok",
              "failed"
            ]
          },
          "engine": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "version",
              "commit"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              }
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "exitCode",
              "timedOut",
              "cleanupComplete"
            ],
            "properties": {
              "outcome": {
                "type": "string"
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "timedOut": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "cleanupComplete": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "details": {
            "type": "object"
          },
          "durationMs": {
            "minimum": 0,
            "type": "number"
          },
          "memory": {
            "properties": {
              "method": {
                "type": "string"
              },
              "bytes": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "method",
              "bytes"
            ],
            "additionalProperties": false,
            "type": "object"
          },
          "conversion": {
            "required": [
              "action",
              "identity",
              "sha256",
              "reason",
              "nativeDurationMs"
            ],
            "properties": {
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "origin": {
                "required": [
                  "record",
                  "condition",
                  "experiment",
                  "freeze",
                  "nativeDurationMs",
                  "memory"
                ],
                "properties": {
                  "memory": {
                    "properties": {
                      "method": {
                        "type": "string"
                      },
                      "bytes": {
                        "minimum": 0,
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "method",
                      "bytes"
                    ],
                    "additionalProperties": false,
                    "type": "object"
                  },
                  "experiment": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  "nativeDurationMs": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "record": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  "freeze": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  "condition": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "type": "object"
              },
              "nativeDurationMs": {
                "minimum": 0,
                "type": "number"
              },
              "action": {
                "enum": [
                  "executed",
                  "reused",
                  "rejected"
                ]
              },
              "identity": {
                "required": [
                  "schema",
                  "engine",
                  "source",
                  "entrypoint",
                  "options",
                  "environment",
                  "environmentPolicy",
                  "powershell",
                  "hostRuntime",
                  "memoryMethod"
                ],
                "properties": {
                  "schema": {
                    "const": "latexai/conversion-identity/1"
                  }
                },
                "type": "object"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "freeze": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "reused"
                    }
                  }
                },
                "then": {
                  "required": [
                    "origin"
                  ]
                }
              }
            ],
            "additionalProperties": false,
            "type": "object"
          },
          "legacy": {
            "properties": {
              "batch": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "limitations": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "memory": {
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "bytes": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "method",
                  "bytes"
                ],
                "additionalProperties": false,
                "type": "object"
              },
              "appliedRules": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "invocationContract": {
                "enum": [
                  "recorded-cwd",
                  "receipt-source-cwd"
                ]
              },
              "nativeDurationMs": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "raw": {
                "items": {
                  "properties": {
                    "bytes": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "bytes",
                    "name"
                  ],
                  "additionalProperties": false,
                  "type": "object"
                },
                "type": "array"
              },
              "rule": {
                "const": "receipt-native-fields/1"
              }
            },
            "required": [
              "rule",
              "batch",
              "receipt",
              "raw",
              "appliedRules",
              "limitations",
              "nativeDurationMs",
              "memory",
              "invocationContract"
            ],
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
    },
    "comparisons": {
      "items": {
        "properties": {
          "right": {
            "type": "string"
          },
          "process": {
            "type": "object"
          },
          "mode": {
            "enum": [
              "parity",
              "replay",
              "regression",
              "styles"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "incomplete"
            ]
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "left": {
            "type": "string"
          },
          "report": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "durationMs": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "left",
          "right",
          "mode",
          "required",
          "status",
          "report",
          "process",
          "durationMs",
          "issues"
        ],
        "additionalProperties": false,
        "type": "object"
      },
      "type": "array"
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "integrityIssues": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reuse": {
      "required": [
        "schema",
        "mode",
        "batch",
        "experiment"
      ],
      "properties": {
        "schema": {
          "const": "latexai/reuse-plan/1"
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "experiment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "mode": {
          "enum": [
            "analysis-only",
            "selective"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
