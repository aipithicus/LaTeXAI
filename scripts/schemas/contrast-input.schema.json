{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "conditions", "comparisons"],
  "properties": {
    "schema": {"const": "latexai/contrast-input/1"},
    "conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "capture", "includeStyles"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "capture": {"type": "boolean"}, "includeStyles": {"type": "boolean"},
          "arguments": {"type": "array", "items": {"type": "string"}},
          "engineRoot": {"type": "string", "minLength": 1},
          "legacy": {
            "type": "object", "additionalProperties": false,
            "required": ["directory", "rule"],
            "properties": {
              "directory": {"type": "string", "minLength": 1},
              "rule": {"const": "receipt-native-fields/1"}
            }
          }
        },
        "not": {"required": ["engineRoot", "legacy"]}
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "left", "right", "mode", "required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "left": {"$ref": "#/$defs/id"}, "right": {"$ref": "#/$defs/id"},
          "mode": {"enum": ["parity", "regression", "styles"]}, "required": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
}
