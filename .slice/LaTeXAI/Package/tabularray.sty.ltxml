package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# CTAN: tabularray v2025C (rev 78251)
# Pure native binding mapping LaTeX3 tabularray environments to LaTeXML tabular IR.

RequirePackage('array');
RequirePackage('booktabs');

DeclareOption(undef, sub { });
ProcessOptions();

# Q[] / X[] only: a following bare DefColumnType('Q') would clobber the optional form.
# Bare Q defaults to justify, matching tabularray (not center).
DefColumnType('X[]', sub {
  my ($stomach, $opt) = @_;
  my $align = 'justify';
  if ($opt) {
    my $str = ToString($opt);
    if    ($str =~ /\bl\b/) { $align = 'left'; }
    elsif ($str =~ /\br\b/) { $align = 'right'; }
    elsif ($str =~ /\bc\b/) { $align = 'center'; }
  }
  $LaTeXML::BUILD_TEMPLATE->addColumn(
    before => Tokens(T_CS('\vtop'), T_BEGIN),
    after  => Tokens(T_END),
    align  => $align);
  return;
});

DefColumnType('Q[]', sub {
  my ($stomach, $opt) = @_;
  my $align = 'justify';
  if ($opt) {
    my $str = ToString($opt);
    if    ($str =~ /\bl\b/) { $align = 'left'; }
    elsif ($str =~ /\br\b/) { $align = 'right'; }
    elsif ($str =~ /\bc\b/) { $align = 'center'; }
    elsif ($str =~ /\bj\b/) { $align = 'justify'; }
  }
  $LaTeXML::BUILD_TEMPLATE->addColumn(align => $align);
  return;
});

# Inner-spec keys. columns= is NOT a colspec (it styles every column).
my %TBLR_FLAG = map { $_ => 1 } qw(hlines vlines hline vline);
my %TBLR_KEY  = map { $_ => 1 } qw(
  colspec rowspec width hlines vlines hline vline
  cells cell rows row columns column stretch
  rulesep rowsep colsep abovesep belowsep leftsep rightsep
  baselineskip baseline);

sub _tblr_skip_spaces {
  my ($toks, $i) = @_;
  while ($i < scalar(@$toks) && $$toks[$i]->getCatcode == CC_SPACE) { $i++; }
  return $i;
}

sub _tblr_split_items {
  my ($tokens) = @_;
  return () unless $tokens;
  my @toks  = $tokens->unlist;
  my @items = ();
  my @cur   = ();
  my $depth = 0;
  for my $tok (@toks) {
    my $cc = $tok->getCatcode;
    if ($cc == CC_BEGIN) { $depth++; push(@cur, $tok); }
    elsif ($cc == CC_END) { $depth--; push(@cur, $tok); }
    elsif ($depth == 0 && $tok->equals(T_OTHER(','))) {
      push(@items, Tokens(@cur)) if @cur;
      @cur = ();
    }
    else { push(@cur, $tok); }
  }
  push(@items, Tokens(@cur)) if @cur;
  return @items;
}

sub _tblr_item_kv {
  my ($item) = @_;
  my @toks = $item->unlist;
  my $i    = _tblr_skip_spaces(\@toks, 0);
  my @key  = ();
  while ($i < scalar(@toks)) {
    my $t = $toks[$i];
    last if $t->equals(T_OTHER('='));
    last if $t->getCatcode == CC_SPACE;
    push(@key, $t);
    $i++;
  }
  my $key = ToString(Tokens(@key));
  $key =~ s/^\s+|\s+$//g;
  $i = _tblr_skip_spaces(\@toks, $i);
  if ($i < scalar(@toks) && $toks[$i]->equals(T_OTHER('='))) {
    $i++;
    $i = _tblr_skip_spaces(\@toks, $i);
    my @val = @toks[$i .. $#toks];
    while (@val && $val[0]->getCatcode == CC_SPACE) { shift(@val); }
    while (@val && $val[-1]->getCatcode == CC_SPACE) { pop(@val); }
    if (@val && $val[0]->getCatcode == CC_BEGIN && $val[-1]->getCatcode == CC_END) {
      shift(@val); pop(@val);
    }
    return ($key, Tokens(@val));
  }
  return ($key, undef);
}

sub _tblr_read_group {
  my ($s, $i, $open, $close) = @_;
  return ('', $i) unless $i < length($s) && substr($s, $i, 1) eq $open;
  my $depth = 0;
  my $j     = $i;
  my $n     = length($s);
  while ($j < $n) {
    my $c = substr($s, $j, 1);
    $depth++ if $c eq $open;
    $depth-- if $c eq $close;
    $j++;
    last if $depth == 0;
  }
  return (substr($s, $i + 1, $j - $i - 2), $j);
}

sub _tblr_split_colspec {
  my ($s) = @_;
  $s = '' unless defined $s;
  my @units = ();
  my $i     = 0;
  my $n     = length($s);
  my $prefix = '';
  while ($i < $n) {
    my $c = substr($s, $i, 1);
    if ($c =~ /\s/) { $i++; next; }
    if ($c eq '|') { $i++; next; }
    if ($c eq '*' ) {
      $i++;
      my ($rep, $ni) = _tblr_read_group($s, $i, '{', '}');
      $i = $ni;
      my ($spec, $si) = _tblr_read_group($s, $i, '{', '}');
      $i = $si;
      push(@units, $prefix . "*{$rep}{$spec}");
      $prefix = '';
      next;
    }
    if ($c eq '>' || $c eq '<' || $c eq '@' || $c eq '!') {
      $i++;
      my ($arg, $ni) = _tblr_read_group($s, $i, '{', '}');
      $i = $ni;
      $prefix .= $c . '{' . $arg . '}';
      next;
    }
    if ($c =~ /[A-Za-z]/) {
      my $unit = $prefix . $c;
      $prefix = '';
      $i++;
      if ($i < $n && substr($s, $i, 1) eq '[') {
        my ($opt, $ni) = _tblr_read_group($s, $i, '[', ']');
        $unit .= '[' . $opt . ']';
        $i = $ni;
      }
      if ($i < $n && substr($s, $i, 1) eq '{') {
        my ($arg, $ni) = _tblr_read_group($s, $i, '{', '}');
        $unit .= '{' . $arg . '}';
        $i = $ni;
      }
      push(@units, $unit);
      next;
    }
    $i++;
  }
  push(@units, $prefix) if $prefix ne '';
  return @units;
}

sub _tblr_parse_inner {
  my ($inner) = @_;
  my $hlines  = 0;
  my $vlines  = 0;
  my $colspec;
  my $width;
  return ('*{50}{l}', 0, 0, undef) unless $inner;
  my @items = _tblr_split_items($inner);
  my $has_eq = 0;
  my @flags  = ();
  for my $item (@items) {
    my ($key, $val) = _tblr_item_kv($item);
    next unless defined $key && $key ne '';
    if (defined $val) {
      $has_eq = 1;
      if ($key eq 'colspec') {
        $colspec = $val;
      } elsif ($key eq 'width') {
        $width = $val;
      }
      # columns= styles every column; it is not a colspec.
    } else {
      push(@flags, $key);
      $hlines = 1 if $key eq 'hlines' || $key eq 'hline';
      $vlines = 1 if $key eq 'vlines' || $key eq 'vline';
    }
  }
  if (!defined $colspec) {
    if (!$has_eq && scalar(@items) == 1 && !$TBLR_FLAG{ $flags[0] // '' } && !$TBLR_KEY{ $flags[0] // '' }) {
      $colspec = $items[0];
    } else {
      $colspec = TokenizeInternal('*{50}{l}');
    }
  }
  my $cs = ToString($colspec);
  $cs =~ s/^\s+|\s+$//g;
  if ($vlines && $cs !~ /\|/) {
    if ($cs =~ /^\*\{(\d+)\}\{(.+)\}$/) {
      $cs = '|*{' . $1 . '}{' . $2 . '|}';
    } else {
      my @units = _tblr_split_colspec($cs);
      @units = ('l') unless @units;
      $cs = '|' . join('|', @units) . '|';
    }
    $colspec = TokenizeInternal($cs);
  }
  return ($colspec, $hlines, $vlines, $width);
}

sub _tblr_parse_outer {
  my ($outer) = @_;
  return (undef, undef, undef, undef) unless $outer;
  my $width;
  my $vattach;
  my $caption;
  my $label;
  for my $item (_tblr_split_items($outer)) {
    my ($key, $val) = _tblr_item_kv($item);
    next unless defined $key;
    if ($key eq 'width' && $val) {
      $width = $val;
    } elsif ($key eq 'baseline' && $val) {
      my $p = ToString($val);
      $p =~ s/^\s+|\s+$//g;
      $vattach = translateAttachment($p) if $p =~ /^[tmb]$/i;
    } elsif ($key eq 'caption' && $val) {
      $caption = $val;
    } elsif ($key eq 'label' && $val) {
      $label = $val;
    } elsif ($key =~ /^[tmb]$/i && !defined $val) {
      $vattach = translateAttachment($key);
    }
  }
  return ($width, $vattach, $caption, $label);
}

sub _tblr_read_until_cell_end {
  my ($gullet) = @_;
  my @tokens   = ();
  while (defined(my $tok = $gullet->readToken)) {
    my $cc = $tok->getCatcode;
    if ($cc == CC_BEGIN) {
      push(@tokens, $tok, $gullet->readBalanced->unlist, T_END);
      next;
    }
    if ($tok->equals(T_ALIGN)) {
      return (Tokens(@tokens), 'align');
    }
    my $s = $tok->getString;
    if ($tok->getCatcode == CC_CS && ($s eq '\\' || $s eq '\cr' || $s eq '\crcr'
        || $s eq '\tabularnewline' || $s eq '\lx@hidden@crcr')) {
      $gullet->unread($tok);
      return (Tokens(@tokens), 'cr');
    }
    push(@tokens, $tok);
  }
  return (Tokens(@tokens), 'eof');
}

DefPrimitive('\lx@tblr@rowspan{}', sub {
  my ($stomach, $n) = @_;
  if (my $alignment = LookupValue('Alignment')) {
    my $col = $alignment->currentColumn;
    my $r   = int(ToString($n));
    $$col{rowspan} = $r if $col && $r > 1;
  }
  return ();
});

DefPrimitive('\lx@tblr@cellstyle{}', sub {
  my ($stomach, $styles) = @_;
  if (my $alignment = LookupValue('Alignment')) {
    my $col = $alignment->currentColumn;
    if ($col && $styles) {
      my $st = ToString($styles);
      if ($st =~ /\b([lcrj])\b/) {
        my %m = (l => 'left', r => 'right', c => 'center', j => 'justify');
        $$col{align} = $m{$1};
      }
      if ($st =~ /\b([tmb])\b/) {
        $$col{vattach} = translateAttachment($1);
      }
    }
  }
  return ();
});

DefPrimitive('\lx@tblr@setuphlines', sub {
  return () unless LookupValue('tblr_hlines');
  Let('\lx@tblr@savedcr', '\\\\');
  DefMacroI('\\\\', undef, '\lx@tblr@savedcr\hline');
  return ();
});

DefMacro('\tblr OptionalUndigested Undigested', sub {
  my ($gullet, $outer, $inner) = @_;
  my ($colspec, $hlines, $vlines, $iwidth) = _tblr_parse_inner($inner);
  my ($owidth, $vattach, $caption, $label) = _tblr_parse_outer($outer);
  my $width = $owidth || $iwidth;
  AssignValue('tblr_hlines' => $hlines ? 1 : 0);

  my @bind = (T_CS('\@tabular@bindings'), T_BEGIN, $colspec->unlist, T_END);
  my @kv   = ();
  push(@kv, T_OTHER('width'), T_OTHER('='), $width->unlist) if $width;
  if ($vattach) {
    push(@kv, T_OTHER(',')) if @kv;
    push(@kv, Explode("vattach=$vattach"));
  }
  if (@kv) {
    push(@bind, T_OTHER('['), @kv, T_OTHER(']'));
  }

  return Tokens(
    @bind,
    T_CS('\lx@tblr@setuphlines'),
    T_CS('\@@tblr'),
    ($outer ? (T_OTHER('['), $outer->unlist, T_OTHER(']')) : ()),
    T_BEGIN, $inner->unlist, T_END,
    T_CS('\lx@begin@alignment'),
    ($hlines ? T_CS('\hline') : ())
  );
});

DefMacro('\endtblr', '\lx@end@alignment\@end@tblr');
DefPrimitive('\@end@tblr', sub { $_[0]->egroup; });

DefConstructor('\@@tblr OptionalUndigested Undigested DigestedBody',
  '#3',
  beforeDigest    => sub { $_[0]->bgroup; },
  mode            => 'restricted_horizontal',
  enterHorizontal => 1);

DefMacro('\longtblr OptionalUndigested Undigested', sub {
  my ($gullet, $outer, $inner) = @_;
  my ($owidth, $vattach, $caption, $label) = _tblr_parse_outer($outer);
  my @tokens = ();
  if ($caption) {
    push(@tokens, T_CS('\table'));
    push(@tokens, T_CS('\caption'), T_BEGIN, $caption->unlist, T_END);
    push(@tokens, T_CS('\label'), T_BEGIN, $label->unlist, T_END) if $label;
    AssignValue('longtblr_has_table', 1);
  } else {
    AssignValue('longtblr_has_table', 0);
  }
  push(@tokens, T_CS('\tblr'),
    ($outer ? (T_OTHER('['), $outer->unlist, T_OTHER(']')) : ()),
    T_BEGIN, $inner->unlist, T_END);
  return Tokens(@tokens);
});

DefMacro('\endlongtblr', sub {
  my @tokens = (T_CS('\endtblr'));
  if (LookupValue('longtblr_has_table')) {
    push(@tokens, T_CS('\endtable'));
    AssignValue('longtblr_has_table', 0);
  }
  return Tokens(@tokens);
});

DefMacro('\talltblr OptionalUndigested Undigested', '\longtblr[#1]{#2}');
DefMacro('\endtalltblr',                           '\endlongtblr');

# \SetCell[c=N] lowers to \multicolumn, swallowing the N-1 covered & cells.
# Rowspan stays on the cell hash; the engine does not recompute it.
DefMacro('\SetCell OptionalUndigested Undigested', sub {
  my ($gullet, $keyvals, $styles) = @_;
  my $c = 1;
  my $r = 1;
  if ($keyvals) {
    my $kv = ToString($keyvals);
    $r = int($1) if $kv =~ /\br\s*=\s*(\d+)/;
    $c = int($1) if $kv =~ /\bc\s*=\s*(\d+)/;
  }
  my $align = 'c';
  if ($styles) {
    my $st = ToString($styles);
    $align = $1 if $st =~ /\b([lcr])\b/;
  }
  my @pre = ();
  push(@pre, T_CS('\lx@tblr@rowspan'), T_BEGIN, Explode($r), T_END) if $r > 1;
  if ($c <= 1) {
    push(@pre, T_CS('\lx@tblr@cellstyle'), T_BEGIN,
      ($styles ? $styles->unlist : ()), T_END);
    return Tokens(@pre);
  }
  my ($body, $why) = _tblr_read_until_cell_end($gullet);
  my $emit_and = 0;
  if ($why eq 'align') {
    my $last = 'align';
    for (1 .. $c - 1) {
      my ($junk, $w) = _tblr_read_until_cell_end($gullet);
      $last = $w;
      last if $w ne 'align';
    }
    $emit_and = ($last eq 'align') ? 1 : 0;
  }
  return Tokens(
    @pre,
    T_CS('\multicolumn'),
    T_BEGIN, Explode($c), T_END,
    T_BEGIN, Explode($align), T_END,
    T_BEGIN, $body->unlist, T_END,
    ($emit_and ? T_ALIGN : ())
  );
});

DefMacro('\SetRow{}',   '');
DefMacro('\SetHline{}', '');
DefMacro('\SetVline{}', '');

DefMacro('\UseTblrLibrary{}', sub {
  my ($gullet, $libs) = @_;
  for my $lib (split(/,/, ToString($libs))) {
    $lib =~ s/^\s+//; $lib =~ s/\s+$//;
    if ($lib eq 'booktabs') {
      RequirePackage('booktabs');
    } elsif ($lib eq 'amsmath') {
      RequirePackage('amsmath');
    } elsif ($lib eq 'siunitx') {
      RequirePackage('siunitx');
    } elsif ($lib eq 'diagbox') {
      RequirePackage('diagbox');
    }
  }
  return ();
});

DefMacro('\SetTblrInner OptionalUndigested {}', '');
DefMacro('\SetTblrOuter OptionalUndigested {}', '');
DefMacro('\NewTblrEnviron{}', sub {
  my ($gullet, $name) = @_;
  my $n = ToString($name);
  $n =~ s/^\s+//; $n =~ s/\s+$//;
  DefMacro('\\' . $n . ' OptionalUndigested Undigested', '\tblr[#1]{#2}');
  DefMacro('\\end' . $n,                                '\endtblr');
  return ();
});
DefMacro('\DefTblrTemplate{}{}{}',           '');
DefMacro('\SetTblrTemplate{}{}',             '');
DefMacro('\SetTblrStyle{}{}',                '');
DefMacro('\NewTableCommand Semiverbatim {}', '');

1;
