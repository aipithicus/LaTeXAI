package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# CTAN: ltxcmds v1.26 (2023-12-04), TeX Live revision 79461.
# Class: shim
# Native replacement of InputDefinitions('ltxcmds'). Written from
# lib-ctan/ltxcmds/tex/generic/ltxcmds/ltxcmds.sty.
# Maps the public helper surface onto the LaTeX kernel equivalents
# already in the pool. Register aliases, box tests, and character
# constants are residue (on purpose: no IR effect; no native consumer).
# Macro concatenation preserves prepend/append order and local/global
# scope, including initially undefined or relaxed targets. Space removal
# retains token identity and spaces protected by groups.

DeclareOption(undef, sub { });
ProcessOptions();

Let('\ltx@gobble',      '\@gobble');
Let('\ltx@gobbletwo',   '\@gobbletwo');
Let('\ltx@gobblefour',  '\@gobblefour');
DefMacro('\ltx@gobblethree{}{}{}', Tokens());
Let('\ltx@firstofone',   '\@firstofone');
Let('\ltx@firstoftwo',   '\@firstoftwo');
Let('\ltx@secondoftwo',  '\@secondoftwo');
Let('\ltx@thirdofthree', '\@thirdofthree');
DefMacro('\ltx@firstofthree{}{}{}',    sub { $_[1]; });
DefMacro('\ltx@secondofthree{}{}{}',   sub { $_[2]; });
DefMacro('\ltx@firstoffour{}{}{}{}',   sub { $_[1]; });
DefMacro('\ltx@secondoffour{}{}{}{}',  sub { $_[2]; });
DefMacro('\ltx@thirdoffour{}{}{}{}',   sub { $_[3]; });
DefMacro('\ltx@fourthoffour{}{}{}{}',  sub { $_[4]; });

Let('\ltx@car',        '\@car');
Let('\ltx@cdr',        '\@cdr');
Let('\ltx@empty',      '\@empty');
Let('\ltx@ifnextchar', '\@ifnextchar');
Let('\ltx@newif',      '\newif');
Let('\ltx@leavevmode', '\leavevmode');
Let('\ltx@mbox',       '\mbox');

Let('\ltx@ifundefined',     '\@ifundefined');
Let('\ltx@IfUndefined',     '\@ifundefined');
Let('\ltx@ifpackageloaded', '\@ifpackageloaded');
Let('\ltx@ifclassloaded',   '\@ifclassloaded');

DefMacro('\ltx@iffileloaded{}{}{}',
  '\@ifundefined{ver@#1}{#3}{#2}');
Let('\ltx@ifpackagelater', '\@ifpackagelater');
Let('\ltx@ifclasslater',   '\@ifclasslater');

DefMacro('\ltx@ifempty{}{}{}', sub {
    my ($gullet, $toks, $yes, $no) = @_;
    return ((ToString($toks) eq '') ? $yes : $no)->unlist; });
DefMacro('\ltx@ifblank{}{}{}', sub {
    my ($gullet, $toks, $yes, $no) = @_;
    my $s = ToString($toks);
    $s =~ s/^\s+|\s+$//g;
    return (($s eq '') ? $yes : $no)->unlist; });
DefMacro('\ltx@zapspace{}', sub {
    my (@kept, $depth);
    $depth = 0;
    foreach my $token ($_[1]->unlist) {
      my $cc = $token->getCatcode;
      $depth++ if $cc == CC_BEGIN;
      push(@kept, $token) unless $cc == CC_SPACE && !$depth;
      $depth-- if $cc == CC_END;
    }
    return Tokens(@kept); });

foreach my $scope (qw(Local Global)) {
  foreach my $operation (qw(Append Prepend)) {
    DefPrimitive('\ltx@' . $scope . $operation . 'ToMacro{}{}', sub {
        my ($stomach, $target, $addition) = @_;
        my @target = $target->unlist;
        if (@target != 1 || $target[0]->getCatcode != CC_CS) {
          Error('unexpected', 'ltxcmds-target', $stomach,
            'Macro concatenation requires one control sequence');
          return;
        }
        my $cs = $target[0];
        my $definition = LookupDefinition($cs);
        my @old;
        if ($definition && !$definition->getCS->equals(T_CS('\relax'))) {
          if (!$definition->isExpandable || ref($definition->getExpansion) eq 'CODE') {
            Error('unsupported', 'ltxcmds-target', $stomach,
              'Macro concatenation requires a token-list macro');
            return;
          }
          my $expansion = $definition->getExpansion;
          @old = (ref $expansion ? $expansion : TokenizeInternal($expansion))->unlist;
        }
        my @added = $addition->unlist;
        local $LaTeXML::Core::State::UNLOCKED = 1;
        DefMacroI($cs, undef,
          Tokens($operation eq 'Prepend' ? (@added, @old) : (@old, @added)),
          nopackParameters => 1, scope => lc($scope),
          locked => ($definition && $$definition{locked}));
        return;
      });
  }
}

DefRegister('\ltx@zero' => Number(0));
DefRegister('\ltx@one'  => Number(1));
DefRegister('\ltx@two'  => Number(2));

# Residue (on purpose): \ltx@LocToksA..E / GlobToks / LocDimen / LocSkip,
# \ltx@GobbleNum / CarNum / CdrNum, \ltx@IfBoxEmpty, character constants
# (\ltx@percentchar etc.), \ltx@onelevel@sanitize, \ltx@ReturnAfterFi,
# \ltx@ReturnAfterElseFi. No native consumer.

1;
