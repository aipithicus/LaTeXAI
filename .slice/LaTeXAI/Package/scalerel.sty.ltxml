# Emulates scalerel 1.8 (2016-12-29); audited against the package
# documentation and lib-ctan/scalerel/tex/latex/scalerel/scalerel.sty,
# TeX Live revision 79618. Model: native TeX XMWrap math grouping and
# lx@left/lx@right delimiter constructors, with the caller's math style.
# Supports scalerel/stretchrel (star and optional constraint),
# scaleleftright/stretchleftright, and scaleobj in math mode. The existing
# stretchobj is a fork extension, absent from the package source.
# Scaling kind is retained as a class; numeric sizing/reference geometry
# remains in the reverted TeX, not a computed physical transform. Text-mode
# scaling and the other source commands are not implemented. One-sided
# delimiters may retain ltx_math_unparsed, as in native left/right math.
# Raw calc/graphicx/etoolbox dependencies perform geometric measurements;
# this native subset does not load them or inherit their unrelated surface.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# \scalerel*[max]{object}{reference} and \scalerel[max]{object}{reference}
DefConstructor('\scalerel OptionalMatch:* [] {} {}',
  "<ltx:XMWrap class='ltx_scalerel' stretchy='true'>#3</ltx:XMWrap>?#1()(#4)");

# \stretchrel*[min]{object}{reference} and \stretchrel[min]{object}{reference}
DefConstructor('\stretchrel OptionalMatch:* [] {} {}',
  "<ltx:XMWrap class='ltx_stretchrel' stretchy='true'>#3</ltx:XMWrap>?#1()(#4)");

# TeXDelimiter keeps a literal dot invisible and marks real delimiters
# stretchy, rather than relying on a wrapper attribute lost by parsing.
# \scaleleftright[max]{left}{body}{right}
DefConstructor('\scaleleftright [] Undigested {} Undigested',
  "<ltx:XMWrap class='ltx_scaleleftright'>"
    . "#left"
    . "<ltx:XMArg>#3</ltx:XMArg>"
    . "#right"
    . "</ltx:XMWrap>",
  properties => sub {
    my ($stomach, $max, $left, $body, $right) = @_;
    return (left => Digest(Tokens(T_CS('\lx@left'), $left->unlist)),
      right => Digest(Tokens(T_CS('\lx@right'), $right->unlist))); });

# \stretchleftright[min]{left}{body}{right}
DefConstructor('\stretchleftright [] Undigested {} Undigested',
  "<ltx:XMWrap class='ltx_stretchleftright'>"
    . "#left"
    . "<ltx:XMArg>#3</ltx:XMArg>"
    . "#right"
    . "</ltx:XMWrap>",
  properties => sub {
    my ($stomach, $min, $left, $body, $right) = @_;
    return (left => Digest(Tokens(T_CS('\lx@left'), $left->unlist)),
      right => Digest(Tokens(T_CS('\lx@right'), $right->unlist))); });

# Dimension / width helpers
DefConstructor('\scaleobj {} {}',
  "<ltx:XMWrap class='ltx_scaleobj' stretchy='true'>#2</ltx:XMWrap>");
DefConstructor('\stretchobj {} {}',
  "<ltx:XMWrap class='ltx_stretchobj' stretchy='true'>#2</ltx:XMWrap>");

1;
