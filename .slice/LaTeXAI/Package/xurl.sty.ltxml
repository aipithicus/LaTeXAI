package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# CTAN: xurl v0.10 (rev 77682)
# Pure native binding eliminating InputDefinitions('xurl').

DeclareOption('nobiblatex', sub { });
DeclareOption(undef, sub {
  PassOptions('url', 'sty', ToString(Expand(T_CS('\CurrentOption')))); });
ProcessOptions();

RequirePackage('url');

# xurl extends URL break points for print layouts. In XML/HTML semantic IR,
# URLs are hyperlinks (<ltx:ref>) and linebreaking penalties are no-ops.
DefMacro('\useOriginalUrlSetting', '');
DefMacro('\UrlBreaks',             '');

1;
