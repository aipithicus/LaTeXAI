# Native containment envelope replacing InputDefinitions('pgf'). Does not
# execute raw PGF, pgfsys, or the SVG driver. {pgfpicture} is captured as
# tokens and harvested into <ltx:picture>/<ltx:g>: node text, quoted
# labels, and $...$ / \(...\) / \[...\]. Drawing macros are not expanded,
# so unknown library commands cannot hit the 100-error cap. Model:
# listings/comment env capture plus the latex picture constructors.
# Coordinate geometry, layers, and shadings are out of scope.
# B3 admits bounded literal foreach lists for harvested labels only; see the
# token reader below. Unsupported loops retain their original once-only harvest.
# A picture reverts to its own source form (\begin{env}...\end{env}, or the
# \tikz / \pgfpicture call), and a harvested group to its content, so tex=
# and every other reversion show source syntax, never \lx@pgf@ internals.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;
use LaTeXML::Core::Token;
use LaTeXML::Core::Tokens;

RequirePackage('pgfrcs');
RequirePackage('pgfkeys');
RequirePackage('pgfmath');
RequirePackage('xcolor');

DeclareOption(undef, sub { });
ProcessOptions();

DefMacro('\pgfsysdriver', 'pgfsys-latexml.def');
DefMacro('\usepgfmodule{}',  '');
DefMacro('\usepgflibrary{}', '');
DefMacro('\pgfsetlayers{}',  '');
DefMacro('\pgfdeclarelayer{}', '');
DefMacro('\pgfsetlinewidth{}', '');
DefMacro('\pgfsetcolor{}', '');
DefMacro('\pgfsetfillcolor{}', '');
DefMacro('\pgfsetstrokecolor{}', '');
DefMacro('\pgfdeclareimage[]{}{}', '');
DefMacro('\pgfimage[]{}', '');
DefMacro('\pgfuseimage{}', '');
DefMacro('\pgfpoint{}{}', '');
DefMacro('\pgfpointorigin', '');
DefRegister('\pgflinewidth' => Dimension('0.4pt'));

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# Containment readers and harvest
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

sub tikz_contain_read_options {
  my ($gullet) = @_;
  $gullet->skipSpaces;
  return unless $gullet->ifNext(T_OTHER('['));
  $gullet->readToken;    # consume '['
  my @toks   = ();
  my $depth  = 0;
  my $braces = 0;
  my $closed = 0;
  while (defined(my $tok = $gullet->readToken)) {
    if ($tok->getCatcode == CC_BEGIN) {
      $braces++;
      push(@toks, $tok); }
    elsif ($tok->getCatcode == CC_END) {
      $braces-- if $braces;
      push(@toks, $tok); }
    elsif (!$braces && $tok->equals(T_OTHER('['))) {
      $depth++;
      push(@toks, $tok); }
    elsif (!$braces && $tok->equals(T_OTHER(']'))) {
      if ($depth > 0) {
        $depth--;
        push(@toks, $tok); }
      else {
        $closed = 1;
        last; } }
    else {
      push(@toks, $tok); } }
  Error('expected', 'tikz-options-end', undef, 'Unterminated TikZ/PGF options') unless $closed;
  return Tokens(@toks); }

sub tikz_contain_skip_overlay {
  my ($gullet) = @_;
  $gullet->skipSpaces;
  if ($gullet->ifNext(T_OTHER('<'))) {
    $gullet->readToken;
    my $spec = $gullet->readUntil(T_OTHER('>'));
    return Tokens(T_OTHER('<'), ($spec ? $spec->unlist : ()), T_OTHER('>')); }
  return; }

sub tikz_contain_env_name {
  my ($name) = @_;
  $name = ToString($name);
  $name =~ s/^\s+|\s+$//g;
  return $name; }

sub tikz_contain_read_env_body {
  my ($gullet, $env) = @_;
  my @body  = ();
  my $depth = 1;
  while (defined(my $tok = $gullet->readToken)) {
    if ($tok->equals(T_CS('\begin'))) {
      my $name = $gullet->readArg;
      my $n    = tikz_contain_env_name($name);
      $depth++ if $n eq $env;
      push(@body, $tok, T_BEGIN, (defined $name ? $name->unlist : ()), T_END); }
    elsif ($tok->equals(T_CS('\end'))) {
      my $name = $gullet->readArg;
      my $n    = tikz_contain_env_name($name);
      if ($n eq $env) {
        $depth--;
        last if $depth == 0;
      }
      push(@body, $tok, T_BEGIN, (defined $name ? $name->unlist : ()), T_END); }
    elsif ($tok->equals(T_CS('\\' . $env))) {
      $depth++;
      push(@body, $tok); }
    elsif ($tok->equals(T_CS('\end' . $env))) {
      $depth--;
      last if $depth == 0;
      push(@body, $tok); }
    else {
      push(@body, $tok); } }
  return Tokens(@body); }

sub tikz_contain_skip_balanced {
  my ($arr, $i, $open, $close) = @_;
  my $n     = scalar(@$arr);
  my $depth = 1;
  $i++;
  while ($i < $n && $depth) {
    my $t = $arr->[$i];
    $depth++ if $t->equals($open);
    $depth-- if $t->equals($close);
    $i++; }
  return $i; }

sub tikz_contain_skip_brace {
  my ($arr, $i) = @_;
  return $i unless $i < scalar(@$arr) && $arr->[$i]->getCatcode == CC_BEGIN;
  my $n     = scalar(@$arr);
  my $depth = 1;
  $i++;
  while ($i < $n && $depth) {
    my $cc = $arr->[$i]->getCatcode;
    $depth++ if $cc == CC_BEGIN;
    $depth-- if $cc == CC_END;
    $i++; }
  return $i; }

sub tikz_contain_brace_inner {
  my ($arr, $i) = @_;
  return (undef, $i) unless $i < scalar(@$arr) && $arr->[$i]->getCatcode == CC_BEGIN;
  my $start = $i + 1;
  my $end   = tikz_contain_skip_brace($arr, $i);
  my $inner_end = $end - 1;
  $inner_end = $start if $inner_end < $start;
  my @inner = @$arr[$start .. $inner_end - 1];
  return (Tokens(@inner), $end); }

sub tikz_contain_match_word {
  my ($arr, $i, $word) = @_;
  my @chars = split //, $word;
  return if $i + @chars > @$arr;
  for my $k (0 .. $#chars) {
    my $t  = $arr->[$i + $k];
    my $cc = $t->getCatcode;
    return if $cc != CC_LETTER && $cc != CC_OTHER;
    return if $t->getString ne $chars[$k]; }
  my $next = $arr->[$i + @chars];
  return if $next && $next->getCatcode == CC_LETTER;
  return 1; }

sub tikz_contain_skip_spaces {
  my ($arr, $i) = @_;
  my $n = scalar(@$arr);
  while ($i < $n) {
    my $cc = $arr->[$i]->getCatcode;
    last unless $cc == CC_SPACE || $cc == CC_EOL;
    $i++; }
  return $i; }

sub tikz_contain_skip_node_prefix {
  my ($arr, $i) = @_;
  my $n = scalar(@$arr);
  while ($i < $n) {
    $i = tikz_contain_skip_spaces($arr, $i);
    last if $i >= $n;
    my $t = $arr->[$i];
    last if $t->getCatcode == CC_BEGIN;
    if ($t->equals(T_OTHER('['))) {
      $i = tikz_contain_skip_balanced($arr, $i, T_OTHER('['), T_OTHER(']'));
      next; }
    if ($t->equals(T_OTHER('('))) {
      $i = tikz_contain_skip_balanced($arr, $i, T_OTHER('('), T_OTHER(')'));
      next; }
    if (tikz_contain_match_word($arr, $i, 'at')) {
      $i += 2;
      next; }
    last; }
  return $i; }

sub tikz_contain_nonempty {
  my ($tokens) = @_;
  return unless $tokens;
  my $s = ToString($tokens);
  $s =~ s/\s+//g;
  return length($s) ? $tokens : undef; }

# PGF 3.1.12 pgffor.code.tex:64-143,159-193,209-268. This is a
# label-harvest contract, not a pgffor interpreter. The reader runs no drawing
# code, list expansion, assignment or nested iteration. The picture body remains
# the reversion authority. Limits apply before any part of a loop is emitted.
sub tikz_contain_loop_group {
  my ($arr, $i) = @_;
  return unless $i < @$arr && $arr->[$i]->getCatcode == CC_BEGIN;
  my $end = tikz_contain_skip_brace($arr, $i);
  return unless $end > $i + 1 && $arr->[$end - 1]->getCatcode == CC_END;
  return ([ @$arr[$i + 1 .. $end - 2] ], $end); }

sub tikz_contain_loop_trim {
  my (@toks) = @_;
  shift @toks while @toks && ($toks[0]->getCatcode == CC_SPACE || $toks[0]->getCatcode == CC_EOL);
  pop @toks while @toks && ($toks[-1]->getCatcode == CC_SPACE || $toks[-1]->getCatcode == CC_EOL);
  return \@toks; }

sub tikz_contain_loop_unbrace {
  my ($arr) = @_;
  my ($inner, $end) = tikz_contain_loop_group($arr, 0);
  return $inner && $end == @$arr ? $inner : $arr; }

sub tikz_contain_loop_split {
  my ($arr, $separator) = @_;
  my (@parts, @part);
  my $depth = 0;
  foreach my $tok (@$arr) {
    my $cc = $tok->getCatcode;
    $depth++ if $cc == CC_BEGIN;
    $depth-- if $cc == CC_END;
    if (!$depth && $tok->equals(T_OTHER($separator))) {
      push @parts, tikz_contain_loop_trim(@part);
      @part = (); }
    else { push @part, $tok; } }
  push @parts, tikz_contain_loop_trim(@part);
  return @parts; }

sub tikz_contain_loop_read {
  my ($arr, $start) = @_;
  my $n = @$arr;
  my $i = tikz_contain_skip_spaces($arr, $start + 1);
  my (@spec, $reason);
  while ($i < $n && !tikz_contain_match_word($arr, $i, 'in')) {
    my $tok = $arr->[$i];
    if ($tok->equals(T_OTHER('['))) {
      $reason ||= 'options';
      $i = tikz_contain_skip_balanced($arr, $i, T_OTHER('['), T_OTHER(']')); }
    elsif ($tok->getCatcode == CC_BEGIN || $tok->equals(T_OTHER(';'))) {
      return { end => $n, reason => 'malformed header' }; }
    else { push @spec, $tok; $i++; }
    $i = tikz_contain_skip_spaces($arr, $i); }
  return { end => $n, reason => 'missing in' } if $i >= $n;
  $i = tikz_contain_skip_spaces($arr, $i + 2);
  my ($list, $end) = tikz_contain_loop_group($arr, $i);
  if ($list) { $i = $end; }
  else {
    $reason ||= 'nonliteral list';
    return { end => $n, reason => $reason } if $i >= $n || $arr->[$i]->getCatcode != CC_CS;
    $i++; }
  $i = tikz_contain_skip_spaces($arr, $i);
  my ($body, $bodyend) = tikz_contain_loop_group($arr, $i);
  unless ($body) {
    my $j = $i;
    while ($j < $n && !$arr->[$j]->equals(T_OTHER(';'))) {
      if ($arr->[$j]->getCatcode == CC_BEGIN) {
        my ($unused, $next) = tikz_contain_loop_group($arr, $j);
        return { end => $n, reason => 'unclosed body' } unless $unused;
        $j = $next; }
      else { $j++; } }
    return { end => $n, reason => 'unterminated body' } if $j >= $n;
    $bodyend = $j + 1;
    $body = [ @$arr[$i .. $j] ]; }
  my $loop = { end => $bodyend, body => Tokens(@$body) };
  my (@vars, %seen);
  foreach my $var (tikz_contain_loop_split(\@spec, '/')) {
    if (@$var != 1 || $var->[0]->getCatcode != CC_CS || $seen{$var->[0]->getString}++) {
      $reason ||= 'variable declaration'; last; }
    push @vars, $var->[0]->getString; }
  $reason ||= 'variable limit' if @vars > 8;
  foreach my $tok (@$body, ($list ? @$list : ())) {
    next unless $tok->getCatcode == CC_CS;
    my $name = $tok->getString;
    $reason ||= 'nested loop' if $name eq '\\foreach';
    $reason ||= 'assignment or loop control' if $name =~ /^\\(?:def|gdef|edef|xdef|let|futurelet|newcommand|renewcommand|providecommand|pgfmathsetmacro|pgfmathtruncatemacro|pgfmathparse|breakforeach)$/; }
  my @items;
  if ($list && @{tikz_contain_loop_trim(@$list)}) {
    foreach my $item (tikz_contain_loop_split($list, ',')) {
      $item = tikz_contain_loop_unbrace($item);
      # Coordinate items and ellipses have their own PGF semantics, not CSV.
      $reason ||= 'coordinate list' if grep { $_->equals(T_OTHER('(')) || $_->equals(T_OTHER(')')) } @$item;
      for my $j (0 .. @$item - 3) {
        $reason ||= 'ellipsis' if $item->[$j]->equals(T_OTHER('.'))
          && $item->[$j + 1]->equals(T_OTHER('.')) && $item->[$j + 2]->equals(T_OTHER('.')); }
      my @values = @vars == 1 ? ($item) : tikz_contain_loop_split($item, '/');
      $reason ||= 'incomplete or extra tuple' if @values != @vars;
      @values = map { tikz_contain_loop_unbrace($_) } @values if @vars > 1;
      # Indirect/self-referential iteration values need expansion analysis;
      # exclude them so the bound does not hide recursive local definitions.
      $reason ||= 'dependent values' if grep {
        $_->getCatcode == CC_CS && $seen{$_->getString}
      } map { @$_ } @values;
      push @items, \@values; }
    $reason ||= 'item limit' if @items > 128; }
  $loop->{reason} = $reason if $reason;
  $loop->{vars} = \@vars;
  $loop->{items} = \@items;
  return $loop; }

sub tikz_contain_loop_harvest {
  my ($arr, $start, $budget) = @_;
  my $loop = tikz_contain_loop_read($arr, $start);
  my @chunks;
  unless ($loop->{reason}) {
    my @template = tikz_contain_harvest($loop->{body}, 1);
    $loop->{reason} = 'structural lifting' if grep { $_->{emit} } @template;
    $loop->{reason} = 'coordinate math' if grep { $_->{in_coordinate} } @template;
    unless ($loop->{reason}) {
      my $used = 0;
      ITEM: foreach my $item (@{$loop->{items}}) {
        my %values;
        @values{@{$loop->{vars}}} = @$item;
        # Digest each harvested label with ordinary local TeX definitions.
        # Text substitution loses argument boundaries (\frac\x2); wrapping
        # each occurrence instead changes declarations (\x = \bf). Let the
        # existing gullet expand variables in the context that consumes them.
        my @definitions = (T_BEGIN);
        foreach my $var (@{$loop->{vars}}) {
          push @definitions, T_CS('\\def'), T_CS($var), T_BEGIN, @{$values{$var}}, T_END; }
        foreach my $c (@template) {
          $used += @definitions + 1;
          if ($used > $$budget) { $loop->{reason} = 'picture token limit'; last ITEM; }
          foreach my $tok ($c->{tokens}->unlist) {
            my $value = $tok->getCatcode == CC_CS ? $values{$tok->getString} : undef;
            $used += $value ? @$value : 1;
            if ($used > $$budget) { $loop->{reason} = 'picture token limit'; last ITEM; } }
          push @chunks, { %$c, tokens => Tokens(@definitions, $c->{tokens}->unlist, T_END) }; }
      }
      $$budget -= $used unless $loop->{reason}; } }
  if ($loop->{reason}) {
    Warn('unsupported', 'tikz-foreach', undef,
      'Foreach harvest retained once: ' . $loop->{reason});
    @chunks = tikz_contain_harvest(Tokens(@$arr[$start .. $loop->{end} - 1]), 1); }
  # Inner offsets are local to the body; keep iterations in their own order
  # as one candidate in the surrounding containment overlap resolution.
  return ({ start => $start, end => $loop->{end}, chunks => \@chunks }, $loop->{end}); }

sub tikz_contain_harvest {
  my ($tokens, $no_foreach) = @_;
  return () unless $tokens;
  my @arr = $tokens->unlist;
  return () unless @arr;
  my $n = scalar(@arr);
  my @cands;
  my $i = 0;
  my $paren = 0;
  my $loop_budget = 32768;
  while ($i < $n) {
    my $tok = $arr[$i];
    my $cc  = $tok->getCatcode;
    if ($tok->equals(T_OTHER('('))) {
      $paren++;
      $i++;
      next; }
    if ($tok->equals(T_OTHER(')'))) {
      $paren-- if $paren;
      $i++;
      next; }
    if ($cc == CC_MATH || $tok->equals(T_MATH)) {
      my $j = $i + 1;
      $j++ while $j < $n && !($arr[$j]->getCatcode == CC_MATH || $arr[$j]->equals(T_MATH));
      if ($j < $n) {
        if (tikz_contain_nonempty(Tokens(@arr[$i + 1 .. $j - 1]))) {
          push(@cands, { start => $i, end => $j + 1, class => 'ltx_tikz_math', in_coordinate => $paren,
              tokens => Tokens(@arr[$i .. $j]) }); } }
      $i = ($j < $n ? $j + 1 : $n);
      next; }
    if ($tok->equals(T_CS('\('))) {
      my $j = $i + 1;
      $j++ while $j < $n && !$arr[$j]->equals(T_CS('\)'));
      if ($j < $n) {
        if (tikz_contain_nonempty(Tokens(@arr[$i + 1 .. $j - 1]))) {
          push(@cands, { start => $i, end => $j + 1, class => 'ltx_tikz_math',
              tokens => Tokens(@arr[$i .. $j]) }); } }
      $i = ($j < $n ? $j + 1 : $n);
      next; }
    if ($tok->equals(T_CS('\['))) {
      my $j = $i + 1;
      $j++ while $j < $n && !$arr[$j]->equals(T_CS('\]'));
      if ($j < $n) {
        if (tikz_contain_nonempty(Tokens(@arr[$i + 1 .. $j - 1]))) {
          push(@cands, { start => $i, end => $j + 1, class => 'ltx_tikz_math',
              tokens => Tokens(@arr[$i .. $j]) }); } }
      $i = ($j < $n ? $j + 1 : $n);
      next; }
    if ($cc == CC_CS) {
      my $name = $tok->getString;
      if (!$no_foreach && $name eq '\\foreach') {
        my ($candidate, $next) = tikz_contain_loop_harvest(\@arr, $i, \$loop_budget);
        push @cands, $candidate;
        $i = $next;
        next; }
      if ($name eq '\\Tree' && defined &latexai_qtree_from_array) {
        my ($emit, $ni) = latexai_qtree_from_array(\@arr, $i);
        if ($emit) {
          push(@cands, { start => $i, end => $ni, emit => $emit });
          $i = $ni;
          next; } }
      if ($name eq '\\node' || $name eq '\\legend' || $name eq '\\nodepart') {
        my $start = $i;
        $i++;
        if ($name eq '\\nodepart') {
          $i = tikz_contain_skip_spaces(\@arr, $i);
          $i = tikz_contain_skip_brace(\@arr, $i) if $i < $n && $arr[$i]->getCatcode == CC_BEGIN; }
        $i = tikz_contain_skip_node_prefix(\@arr, $i);
        my ($inner, $ni) = tikz_contain_brace_inner(\@arr, $i);
        if ($inner && tikz_contain_nonempty($inner)) {
          push(@cands, { start => $start, end => $ni, class => 'ltx_tikz_node', tokens => $inner });
          $i = $ni;
          next; } }
    }
    if (!$paren && tikz_contain_match_word(\@arr, $i, 'node')) {
      my $start = $i;
      $i += 4;
      $i = tikz_contain_skip_node_prefix(\@arr, $i);
      my ($inner, $ni) = tikz_contain_brace_inner(\@arr, $i);
      if ($inner && tikz_contain_nonempty($inner)) {
        push(@cands, { start => $start, end => $ni, class => 'ltx_tikz_node', tokens => $inner });
        $i = $ni;
        next; }
      next; }
    if ($tok->equals(T_OTHER('"'))) {
      my $start = $i;
      my $j     = $i + 1;
      $j++ while $j < $n && !$arr[$j]->equals(T_OTHER('"'));
      if ($j < $n) {
        if (my $inner = tikz_contain_nonempty(Tokens(@arr[$i + 1 .. $j - 1]))) {
          push(@cands, { start => $start, end => $j + 1, class => 'ltx_tikz_label', tokens => $inner }); }
        $i = $j + 1;
        next; } }
    $i++; }
  return () unless @cands;
  my @sorted = sort { ($b->{end} - $b->{start}) <=> ($a->{end} - $a->{start}) } @cands;
  my @kept;
CAND: foreach my $c (@sorted) {
    foreach my $k (@kept) {
      next CAND if $k->{start} <= $c->{start} && $c->{end} <= $k->{end}; }
    push(@kept, $c); }
  @kept = sort { $a->{start} <=> $b->{start} } @kept;
  return map { $_->{chunks} ? @{$_->{chunks}} : $_ } @kept; }

sub tikz_contain_string_tokens {
  my ($s) = @_;
  return Tokens(map { T_OTHER($_) } split(//, $s)); }

# Emit the containment envelope. $raw is the source form the picture reverts
# to; it defaults to the body when a caller has nothing better.
sub tikz_contain_emit {
  my ($body, $class, $raw) = @_;
  $class ||= 'ltx_tikz';
  $raw = $body unless defined $raw;
  my @chunks = tikz_contain_harvest($body);
  my @toks   = (T_CS('\lx@pgf@picture'), T_BEGIN, tikz_contain_string_tokens($class)->unlist, T_END, T_BEGIN);
  foreach my $c (@chunks) {
    if ($c->{emit}) {
      push(@toks, $c->{emit}->unlist);
      next; }
    push(@toks, T_CS('\lx@pgf@g'), T_BEGIN, tikz_contain_string_tokens($c->{class})->unlist, T_END,
      T_BEGIN, $c->{tokens}->unlist, T_END); }
  push(@toks, T_END, T_BEGIN, ($raw ? $raw->unlist : ()), T_END);
  return Tokens(@toks); }

# Source form of a captured environment, for reversion.
sub tikz_contain_raw_env {
  my ($env, $opts, $overlay, $body) = @_;
  return Tokens(T_CS('\begin'), T_BEGIN, Explode($env), T_END,
    ($opts    ? (T_OTHER('['), $opts->unlist, T_OTHER(']')) : ()),
    ($overlay ? $overlay->unlist                             : ()),
    ($body    ? $body->unlist                                : ()),
    T_CS('\end'), T_BEGIN, Explode($env), T_END); }

# Source form of the \cmd[opts]... call shape, with an optional tail
# (\endcmd, or the ; that closed a \tikz path).
sub tikz_contain_raw_cmd {
  my ($cmd, $opts, $overlay, $body, @tail) = @_;
  return Tokens(T_CS('\\' . $cmd),
    ($opts    ? (T_OTHER('['), $opts->unlist, T_OTHER(']')) : ()),
    ($overlay ? $overlay->unlist                             : ()),
    ($body    ? $body->unlist                                : ()),
    @tail); }

DefConstructor('\lx@pgf@picture Undigested {} Undigested',
  "<ltx:picture class='#class'>#2</ltx:picture>",
  reversion       => '#3',
  mode            => 'inline_internal_vertical',
  bounded         => 1,
  enterHorizontal => 1,
  beforeConstruct => sub { $_[0]->maybeCloseElement('ltx:p'); },
  afterDigest     => sub {
    my ($stomach, $whatsit) = @_;
    $whatsit->setProperty(class => ToString($whatsit->getArg(1)));
    return; });

DefConstructor('\lx@pgf@g Undigested {}',
  "<ltx:g class='#class'>#2</ltx:g>",
  reversion   => '#2',
  mode        => 'restricted_horizontal',
  bounded     => 1,
  afterDigest => sub {
    my ($stomach, $whatsit) = @_;
    $whatsit->setProperty(class => ToString($whatsit->getArg(1)));
    return; });

sub tikz_contain_begin_env {
  my ($gullet, $env, $class) = @_;
  my $opts    = tikz_contain_read_options($gullet);
  my $overlay = tikz_contain_skip_overlay($gullet);
  my $body    = tikz_contain_read_env_body($gullet, $env);
  return tikz_contain_emit($body, $class, tikz_contain_raw_env($env, $opts, $overlay, $body)); }

DefMacroI(T_CS('\begin{pgfpicture}'), undef, sub {
    return tikz_contain_begin_env($_[0], 'pgfpicture', 'ltx_pgf'); });

DefMacro('\pgfpicture', sub {
    my ($gullet) = @_;
    my $opts = tikz_contain_read_options($gullet);
    my $body = tikz_contain_read_env_body($gullet, 'pgfpicture');
    return tikz_contain_emit($body, 'ltx_pgf',
      tikz_contain_raw_cmd('pgfpicture', $opts, undef, $body, T_CS('\endpgfpicture'))); });

DefMacro('\endpgfpicture', '');

DefMacroI(T_CS('\begin{pgfscope}'), undef, sub {
    return tikz_contain_begin_env($_[0], 'pgfscope', 'ltx_pgf'); });
DefMacro('\pgfscope',    '\begingroup');
DefMacro('\endpgfscope', '\endgroup');

DefMacroI(T_CS('\begin{pgfinterruptpicture}'), undef, sub {
    return tikz_contain_begin_env($_[0], 'pgfinterruptpicture', 'ltx_pgf'); });

1;
