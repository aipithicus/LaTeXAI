package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# CTAN: needspace v1.3e (2025/03/13, rev 77682)
# Page reserves and vertical break penalties are no-ops in XML/HTML.

DefMacro('\needspace{Dimension}',                 '');
DefMacro('\Needspace OptionalMatch:* {Dimension}', '');

#**********************************************************************
1;
