# Native binding for extarrows 1.2.0 (2020-03-12).
# Written from package documentation; audited against the vendored source
# recorded in lib-ctan/extarrows/provenance.json, TeX Live revision 78315.
# Model: amsmath.sty.ltxml's \lx@long@arrow and stretchy arrow symbols.
# Implements all nine package arrows with [under]{over} labels. There are
# no deliberate no-ops. Existing fork extensions, absent from this source,
# are the two xhook arrows, four single xharpoons and two paired xharpoons;
# their output is retained and covered separately by the package suite.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

RequirePackage('amsmath');

# Stretchy symbols used in extensible arrows
DefMathI('\lx@stretchy@longequal', undef, "=",
  role => 'ARROW', stretchy => 'true', meaning => 'equals');
DefMathI('\lx@stretchy@Longleftarrow', undef, "\x{21D0}",
  role => 'ARROW', stretchy => 'true', alias => '\Leftarrow', meaning => 'Leftarrow');
DefMathI('\lx@stretchy@Longrightarrow', undef, "\x{21D2}",
  role => 'ARROW', stretchy => 'true', alias => '\Rightarrow', meaning => 'Rightarrow');
DefMathI('\lx@stretchy@Longleftrightarrow', undef, "\x{21D4}",
  role => 'ARROW', stretchy => 'true', alias => '\Leftrightarrow', meaning => 'Leftrightarrow');
DefMathI('\lx@stretchy@leftrightarrow', undef, "\x{2194}",
  role => 'ARROW', stretchy => 'true', alias => '\leftrightarrow', meaning => 'leftrightarrow');
DefMathI('\lx@stretchy@hookrightarrow', undef, "\x{21AA}",
  role => 'ARROW', stretchy => 'true', alias => '\hookrightarrow', meaning => 'hookrightarrow');
DefMathI('\lx@stretchy@hookleftarrow', undef, "\x{21A9}",
  role => 'ARROW', stretchy => 'true', alias => '\hookleftarrow', meaning => 'hookleftarrow');
DefMathI('\lx@stretchy@rightharpoondown', undef, "\x{21C1}",
  role => 'ARROW', stretchy => 'true', alias => '\rightharpoondown', meaning => 'rightharpoondown');
DefMathI('\lx@stretchy@rightharpoonup', undef, "\x{21C0}",
  role => 'ARROW', stretchy => 'true', alias => '\rightharpoonup', meaning => 'rightharpoonup');
DefMathI('\lx@stretchy@leftharpoondown', undef, "\x{21BD}",
  role => 'ARROW', stretchy => 'true', alias => '\leftharpoondown', meaning => 'leftharpoondown');
DefMathI('\lx@stretchy@leftharpoonup', undef, "\x{21BC}",
  role => 'ARROW', stretchy => 'true', alias => '\leftharpoonup', meaning => 'leftharpoonup');
DefMathI('\lx@stretchy@rightleftharpoons', undef, "\x{21CC}",
  role => 'ARROW', stretchy => 'true', alias => '\rightleftharpoons', meaning => 'rightleftharpoons');
DefMathI('\lx@stretchy@leftrightharpoons', undef, "\x{21CB}",
  role => 'ARROW', stretchy => 'true', alias => '\leftrightharpoons', meaning => 'leftrightharpoons');

# Extensible arrows taking [under]{over}
DefMacro('\xlongequal',          '\lx@long@arrow{\xlongequal}{\lx@stretchy@longequal}');
DefMacro('\xLongleftarrow',       '\lx@long@arrow{\xLongleftarrow}{\lx@stretchy@Longleftarrow}');
DefMacro('\xLongrightarrow',      '\lx@long@arrow{\xLongrightarrow}{\lx@stretchy@Longrightarrow}');
DefMacro('\xLongleftrightarrow',  '\lx@long@arrow{\xLongleftrightarrow}{\lx@stretchy@Longleftrightarrow}');
DefMacro('\xleftrightarrow',      '\lx@long@arrow{\xleftrightarrow}{\lx@stretchy@leftrightarrow}');
DefMacro('\xlongleftrightarrow',  '\lx@long@arrow{\xlongleftrightarrow}{\lx@stretchy@leftrightarrow}');
DefMacro('\xlongleftarrow',       '\lx@long@arrow{\xlongleftarrow}{\lx@stretchy@leftarrow}');
DefMacro('\xlongrightarrow',      '\lx@long@arrow{\xlongrightarrow}{\lx@stretchy@rightarrow}');
DefMacro('\xLeftrightarrow',      '\lx@long@arrow{\xLeftrightarrow}{\lx@stretchy@Longleftrightarrow}');
DefMacro('\xhookrightarrow',      '\lx@long@arrow{\xhookrightarrow}{\lx@stretchy@hookrightarrow}');
DefMacro('\xhookleftarrow',       '\lx@long@arrow{\xhookleftarrow}{\lx@stretchy@hookleftarrow}');
DefMacro('\xrightharpoondown',    '\lx@long@arrow{\xrightharpoondown}{\lx@stretchy@rightharpoondown}');
DefMacro('\xrightharpoonup',      '\lx@long@arrow{\xrightharpoonup}{\lx@stretchy@rightharpoonup}');
DefMacro('\xleftharpoondown',     '\lx@long@arrow{\xleftharpoondown}{\lx@stretchy@leftharpoondown}');
DefMacro('\xleftharpoonup',       '\lx@long@arrow{\xleftharpoonup}{\lx@stretchy@leftharpoonup}');
DefMacro('\xrightleftharpoons',   '\lx@long@arrow{\xrightleftharpoons}{\lx@stretchy@rightleftharpoons}');
DefMacro('\xleftrightharpoons',   '\lx@long@arrow{\xleftrightharpoons}{\lx@stretchy@leftrightharpoons}');

1;
