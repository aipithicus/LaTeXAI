package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;
use LaTeXML::Util::Pathname;
use List::Util qw(min max);

#**********************************************************************
# Organized following
#  "LaTeX: A Document Preparation System"
#   by Leslie Lamport
#   2nd edition
# Addison Wesley, 1994
# Appendix C. Reference Manual
#**********************************************************************
LoadPool('TeX');
LoadFormat('latex');

# LaTeX's zero-argument switch disables inputenc's UTF-8 processing. Mouth
# owns decoding here, so accepting the declaration must consume no input.
DefPrimitive('\UseRawInputEncoding', undef);
#**********************************************************************
1;
