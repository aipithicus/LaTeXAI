<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="algorithm2e" options="linesnumbered,ruled,vlined"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <float class="ltx_algorithm" labels="LABEL:alg:quicksort" xml:id="algorithm1">
    <tags>
      <tag><text font="bold">Algorithm 1</text></tag>
      <tag role="refnum">1</tag>
    </tags>
    <listing class="ltx_lst_numbers_left">
      <listingline xml:id="l1"><tags>
          <tag>1</tag>
          <tag role="refnum">1</tag>
        </tags><text font="bold">Input:</text> Array <Math mode="inline" tex="A" text="A" xml:id="l1.m1">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
          </XMath>
        </Math>, low index <Math mode="inline" tex="p" text="p" xml:id="l1.m2">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">p</XMTok>
          </XMath>
        </Math>, high index <Math mode="inline" tex="r" text="r" xml:id="l1.m3">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">r</XMTok>
          </XMath>
        </Math>;</listingline>
      <listingline xml:id="l2"><tags>
          <tag>2</tag>
          <tag role="refnum">2</tag>
        </tags>
<text font="bold">Result:</text> Partition index <Math mode="inline" tex="q" text="q" xml:id="l2.m1">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">q</XMTok>
          </XMath>
        </Math>;</listingline>
      <listingline xml:id="l3"><tags>
          <tag>3</tag>
          <tag role="refnum">3</tag>
        </tags>
<Math mode="inline" tex="x\leftarrow A[r]" text="x leftarrow A * delimited-[]@(r)" xml:id="l3.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">x</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">A</XMTok>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="delimited-[]"/>
                    <XMRef idref="l3.m1.1"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">[</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="l3.m1.1">r</XMTok>
                    <XMTok role="CLOSE" stretchy="false">]</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMApp>
          </XMath>
        </Math>;</listingline>
      <listingline xml:id="l4"><tags>
          <tag>4</tag>
          <tag role="refnum">4</tag>
        </tags>
<Math mode="inline" tex="i\leftarrow p-1" text="i leftarrow p - 1" xml:id="l4.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">i</XMTok>
              <XMApp>
                <XMTok meaning="minus" role="ADDOP">-</XMTok>
                <XMTok font="italic" role="UNKNOWN">p</XMTok>
                <XMTok meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math>;</listingline>
      <listingline xml:id="l5"><tags>
          <tag>5</tag>
          <tag role="refnum">5</tag>
        </tags>
<text font="bold">for</text> <Math mode="inline" tex="j\leftarrow p" text="j leftarrow p" xml:id="l5.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">j</XMTok>
              <XMTok font="italic" role="UNKNOWN">p</XMTok>
            </XMApp>
          </XMath>
        </Math> <text font="bold">to<Math mode="inline" tex="r-1" text="r - 1" xml:id="l5.m2">
            <XMath>
              <XMApp>
                <XMTok font="medium" meaning="minus" role="ADDOP">-</XMTok>
                <XMTok font="medium italic" role="UNKNOWN">r</XMTok>
                <XMTok font="medium" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
            </XMath>
          </Math></text> <text font="bold">do</text>;</listingline>
      <listingline xml:id="l6"><tags>
          <tag>6</tag>
          <tag role="refnum">6</tag>
        </tags>
/* Compare element with pivot */
<text font="bold">if</text> <Math mode="inline" tex="A[j]\leq x" text="A * delimited-[]@(j) &lt;= x" xml:id="l6.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="less-than-or-equals" name="leq" role="RELOP">≤</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">A</XMTok>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="delimited-[]"/>
                    <XMRef idref="l6.m1.1"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">[</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="l6.m1.1">j</XMTok>
                    <XMTok role="CLOSE" stretchy="false">]</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
              <XMTok font="italic" role="UNKNOWN">x</XMTok>
            </XMApp>
          </XMath>
        </Math> <text font="bold">then</text>;</listingline>
      <listingline xml:id="l7"><tags>
          <tag>7</tag>
          <tag role="refnum">7</tag>
        </tags>  
<Math mode="inline" tex="i\leftarrow i+1" text="i leftarrow i + 1" xml:id="l7.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">i</XMTok>
              <XMApp>
                <XMTok meaning="plus" role="ADDOP">+</XMTok>
                <XMTok font="italic" role="UNKNOWN">i</XMTok>
                <XMTok meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math>;</listingline>
      <listingline xml:id="l8"><tags>
          <tag>8</tag>
          <tag role="refnum">8</tag>
        </tags>   
exchange <Math mode="inline" tex="A[i]" text="A * delimited-[]@(i)" xml:id="l8.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN">A</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="delimited-[]"/>
                  <XMRef idref="l8.m1.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">[</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="l8.m1.1">i</XMTok>
                  <XMTok role="CLOSE" stretchy="false">]</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math> with <Math mode="inline" tex="A[j]" text="A * delimited-[]@(j)" xml:id="l8.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN">A</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="delimited-[]"/>
                  <XMRef idref="l8.m2.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">[</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="l8.m2.1">j</XMTok>
                  <XMTok role="CLOSE" stretchy="false">]</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math>;</listingline>
      <listingline xml:id="l9"><tags>
          <tag>9</tag>
          <tag role="refnum">9</tag>
        </tags>   
<text font="bold">end</text>;</listingline>
      <listingline xml:id="l10"><tags>
          <tag>10</tag>
          <tag role="refnum">10</tag>
        </tags>
<text font="bold">end</text>;</listingline>
      <listingline xml:id="l11"><tags>
          <tag>11</tag>
          <tag role="refnum">11</tag>
        </tags>
exchange <Math mode="inline" tex="A[i+1]" text="A * delimited-[]@(i + 1)" xml:id="l11.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN">A</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="delimited-[]"/>
                  <XMRef idref="l11.m1.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">[</XMTok>
                  <XMApp xml:id="l11.m1.1">
                    <XMTok meaning="plus" role="ADDOP">+</XMTok>
                    <XMTok font="italic" role="UNKNOWN">i</XMTok>
                    <XMTok meaning="1" role="NUMBER">1</XMTok>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">]</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math> with <Math mode="inline" tex="A[r]" text="A * delimited-[]@(r)" xml:id="l11.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN">A</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="delimited-[]"/>
                  <XMRef idref="l11.m2.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">[</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="l11.m2.1">r</XMTok>
                  <XMTok role="CLOSE" stretchy="false">]</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math>;</listingline>
      <listingline xml:id="l12"><tags>
          <tag>12</tag>
          <tag role="refnum">12</tag>
        </tags>
<text font="bold">return</text> <Math mode="inline" tex="i+1" text="i + 1" xml:id="l12.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMTok font="italic" role="UNKNOWN">i</XMTok>
              <XMTok meaning="1" role="NUMBER">1</XMTok>
            </XMApp>
          </XMath>
        </Math>;</listingline>
    </listing>
    <toccaption><tag close=" ">1</tag>Quicksort partition algorithm</toccaption>
    <caption><tag close=" "><text font="bold">Algorithm 1</text></tag>Quicksort partition algorithm</caption>
  </float>
</document>
