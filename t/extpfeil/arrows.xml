  <para xml:id="p1">
    <equation xml:id="S0.Ex1">
      <Math mode="display" tex="A\xtwoheadrightarrow[u]{v}B" text="A u@(v@(twoheadrightarrow)) B" xml:id="S0.Ex1.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMTok font="italic" fontsize="70%" role="UNDERACCENT">u</XMTok>
              <XMApp role="ARROW">
                <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
                <XMTok meaning="twoheadrightarrow" role="ARROW" stretchy="true">↠</XMTok>
              </XMApp>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex2">
      <Math mode="display" tex="A\xtwoheadleftarrow{v}B" text="A v@(twoheadleftarrow) B" xml:id="S0.Ex2.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
              <XMTok meaning="twoheadleftarrow" role="ARROW" stretchy="true">↞</XMTok>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex3">
      <Math mode="display" tex="A\xmapsto{v}B" text="A v@(mapsto) B" xml:id="S0.Ex3.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
              <XMTok meaning="mapsto" role="ARROW" stretchy="true">↦</XMTok>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex4">
      <Math mode="display" tex="A\xlongequal{v}B" text="A v@(=) B" xml:id="S0.Ex4.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
              <XMTok meaning="equals" name="lx@stretchy@longequal" role="ARROW" stretchy="true">=</XMTok>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex5">
      <Math mode="display" tex="A\xtofrom[u]{v}B" text="A u@(v@(rightleftarrows)) B" xml:id="S0.Ex5.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMTok font="italic" fontsize="70%" role="UNDERACCENT">u</XMTok>
              <XMApp role="ARROW">
                <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
                <XMTok meaning="rightleftarrows" role="ARROW" stretchy="true">⇄</XMTok>
              </XMApp>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
  </para>
