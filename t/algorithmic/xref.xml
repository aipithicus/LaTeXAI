              </XMApp>
              <XMApp>
                <XMTok meaning="gcd" role="OPFUNCTION" scriptpos="post" xml:id="alg1.l0a.m1.1">gcd</XMTok>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
