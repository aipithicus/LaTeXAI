    <caption><tag close=" "><text font="bold">Algorithm 1</text></tag> Euclidean Algorithm</caption>
    <listing>
      <listingline xml:id="alg1.l0"><tags>
          <tag><text fontsize="80%">0:</text></tag>
          <tag role="refnum">0</tag>
        </tags> <Math mode="inline" tex="a,b\in\mathbb{N}" text="list@(a, b) element-of N" xml:id="alg1.l0.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="element-of" name="in" role="RELOP">∈</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="list"/>
                  <XMRef idref="alg1.l0.m1.1"/>
                  <XMRef idref="alg1.l0.m1.2"/>
                </XMApp>
                <XMWrap>
                  <XMTok font="italic" role="UNKNOWN" xml:id="alg1.l0.m1.1">a</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="alg1.l0.m1.2">b</XMTok>
                </XMWrap>
              </XMDual>
              <XMTok font="blackboard" role="UNKNOWN">N</XMTok>
            </XMApp>
          </XMath>
        </Math> with <Math mode="inline" tex="a\geq b" text="a &gt;= b" xml:id="alg1.l0.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="greater-than-or-equals" name="geq" role="RELOP">≥</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
            </XMApp>
          </XMath>
        </Math>
</listingline>
      <listingline xml:id="alg1.l0a"><tags>
