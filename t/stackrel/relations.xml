  <para xml:id="p1">
    <equation xml:id="S0.Ex1">
      <Math mode="display" tex="A\stackrel{v}{=}B" text="A v@(=) B" xml:id="S0.Ex1.m1">
        <XMath>
          <XMApp>
            <XMApp role="RELOP">
              <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex2">
      <Math mode="display" tex="A\stackrel[u]{v}{+}B" text="A u@(v@(+)) B" xml:id="S0.Ex2.m1">
