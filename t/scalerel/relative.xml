  <para xml:id="p1">
    <equation xml:id="S0.Ex1">
      <Math mode="display" tex="\scalerel{a}{R}=b" text="a * R = b" xml:id="S0.Ex1.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok class="ltx_scalerel" font="italic" role="UNKNOWN">a</XMTok>
              <XMTok font="italic" role="UNKNOWN">R</XMTok>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">b</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex2">
      <Math mode="display" tex="\scalerel*[2em]{a}{R}=b" text="a = b" xml:id="S0.Ex2.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMTok class="ltx_scalerel" font="italic" role="UNKNOWN">a</XMTok>
            <XMTok font="italic" role="UNKNOWN">b</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex3">
      <Math mode="display" tex="\stretchrel{a}{R}=b" text="a * R = b" xml:id="S0.Ex3.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok class="ltx_stretchrel" font="italic" role="UNKNOWN">a</XMTok>
