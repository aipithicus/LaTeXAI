  <para xml:id="p1">
    <equation xml:id="S0.Ex1">
      <Math mode="display" tex="\begin{tikzcd}A\arrow[rd]&amp;B\\&#10;C\arrow[ru]&amp;D\end{tikzcd}" text="commutative-diagram@(Array[[A  absent, B], [C  absent, D]])" xml:id="S0.Ex1.m1">
        <XMath>
          <XMDual>
            <XMApp>
              <XMTok meaning="commutative-diagram"/>
              <XMRef idref="S0.Ex1.m1.1"/>
            </XMApp>
            <XMArray xml:id="S0.Ex1.m1.1">
              <XMRow>
                <XMCell align="center">
                  <XMApp>
                    <XMApp cd:dir="rd" cd:from="1-1" cd:labelpos="above" cd:style="plain" cd:to="2-2" role="ARROW">
                      <XMTok font="italic" meaning="searrow" name="searrow" role="ARROW" stretchy="true">↘</XMTok>
                    </XMApp>
                    <XMTok font="italic" role="UNKNOWN">A</XMTok>
                    <XMTok meaning="absent"/>
                  </XMApp>
                </XMCell>
                <XMCell align="center">
                  <XMTok font="italic" role="UNKNOWN">B</XMTok>
                </XMCell>
              </XMRow>
              <XMRow>
                <XMCell align="center">
                  <XMApp>
                    <XMApp cd:dir="ru" cd:from="2-1" cd:labelpos="above" cd:style="plain" cd:to="1-2" role="ARROW">
                      <XMTok font="italic" meaning="nearrow" name="nearrow" role="ARROW" stretchy="true">↗</XMTok>
                    </XMApp>
                    <XMTok font="italic" role="UNKNOWN">C</XMTok>
                    <XMTok meaning="absent"/>
                  </XMApp>
                </XMCell>
                <XMCell align="center">
                  <XMTok font="italic" role="UNKNOWN">D</XMTok>
                </XMCell>
              </XMRow>
            </XMArray>
          </XMDual>
        </XMath>
      </Math>
    </equation>
