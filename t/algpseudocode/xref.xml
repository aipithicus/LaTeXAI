          <tag><text fontsize="80%">13:</text></tag>
          <tag role="refnum">13</tag>
        </tags><text font="bold">return</text> <Math mode="inline" tex="-1" text="- 1" xml:id="alg1.l13.m1">
          <XMath>
            <XMApp>
