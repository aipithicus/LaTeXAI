    <toccaption><tag close=" ">1</tag>Binary Search</toccaption>
    <caption><tag close=" "><text font="bold">Algorithm 1</text></tag> Binary Search</caption>
    <listing>
      <listingline labels="LABEL:line:req" xml:id="alg1.l0"><text font="bold">Require:</text> Sorted array <Math mode="inline" tex="A" text="A" xml:id="alg1.l0.m1">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
          </XMath>
        </Math>, key <Math mode="inline" tex="k" text="k" xml:id="alg1.l0.m2">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">k</XMTok>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:ens" xml:id="alg1.l0a"><text font="bold">Ensure:</text> Index of <Math mode="inline" tex="k" text="k" xml:id="alg1.l0a.m1">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">k</XMTok>
          </XMath>
        </Math> or <Math mode="inline" tex="-1" text="- 1" xml:id="alg1.l0a.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="minus" role="ADDOP">-</XMTok>
              <XMTok meaning="1" role="NUMBER">1</XMTok>
            </XMApp>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:initl" xml:id="alg1.l1"><tags>
          <tag><text fontsize="80%">1:</text></tag>
          <tag role="refnum">1</tag>
        </tags><Math mode="inline" tex="l\leftarrow 1" text="l leftarrow 1" xml:id="alg1.l1.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">l</XMTok>
              <XMTok meaning="1" role="NUMBER">1</XMTok>
            </XMApp>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:initr" xml:id="alg1.l2"><tags>
          <tag><text fontsize="80%">2:</text></tag>
          <tag role="refnum">2</tag>
        </tags><Math mode="inline" tex="r\leftarrow n" text="r leftarrow n" xml:id="alg1.l2.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">r</XMTok>
              <XMTok font="italic" role="UNKNOWN">n</XMTok>
            </XMApp>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:while" xml:id="alg1.l3"><tags>
          <tag><text fontsize="80%">3:</text></tag>
          <tag role="refnum">3</tag>
        </tags><text font="bold">while</text> <Math mode="inline" tex="l\leq r" text="l &lt;= r" xml:id="alg1.l3.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="less-than-or-equals" name="leq" role="RELOP">≤</XMTok>
              <XMTok font="italic" role="UNKNOWN">l</XMTok>
              <XMTok font="italic" role="UNKNOWN">r</XMTok>
            </XMApp>
          </XMath>
        </Math> <text font="bold">do</text>
</listingline>
      <listingline labels="LABEL:line:mid" xml:id="alg1.l4"><tags>
          <tag><text fontsize="80%">4:</text></tag>
          <tag role="refnum">4</tag>
        </tags>  <Math mode="inline" tex="m\leftarrow\lfloor(l+r)/2\rfloor" text="m leftarrow floor@((l + r) / 2)" xml:id="alg1.l4.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">m</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="floor"/>
                  <XMRef idref="alg1.l4.m1.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok name="lfloor" role="OPEN" stretchy="false">⌊</XMTok>
                  <XMApp xml:id="alg1.l4.m1.1">
                    <XMTok meaning="divide" role="MULOP">/</XMTok>
                    <XMDual>
                      <XMRef idref="alg1.l4.m1.1.1"/>
                      <XMWrap>
                        <XMTok role="OPEN" stretchy="false">(</XMTok>
                        <XMApp xml:id="alg1.l4.m1.1.1">
                          <XMTok meaning="plus" role="ADDOP">+</XMTok>
                          <XMTok font="italic" role="UNKNOWN">l</XMTok>
                          <XMTok font="italic" role="UNKNOWN">r</XMTok>
                        </XMApp>
                        <XMTok role="CLOSE" stretchy="false">)</XMTok>
                      </XMWrap>
                    </XMDual>
                    <XMTok meaning="2" role="NUMBER">2</XMTok>
                  </XMApp>
                  <XMTok name="rfloor" role="CLOSE" stretchy="false">⌋</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:if" xml:id="alg1.l5"><tags>
          <tag><text fontsize="80%">5:</text></tag>
          <tag role="refnum">5</tag>
        </tags>  <text font="bold">if</text> <Math mode="inline" tex="A[m]=k" text="A * delimited-[]@(m) = k" xml:id="alg1.l5.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">A</XMTok>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="delimited-[]"/>
                    <XMRef idref="alg1.l5.m1.1"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">[</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="alg1.l5.m1.1">m</XMTok>
                    <XMTok role="CLOSE" stretchy="false">]</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
              <XMTok font="italic" role="UNKNOWN">k</XMTok>
            </XMApp>
          </XMath>
        </Math> <text font="bold">then</text>
</listingline>
      <listingline labels="LABEL:line:retm" xml:id="alg1.l6"><tags>
          <tag><text fontsize="80%">6:</text></tag>
          <tag role="refnum">6</tag>
        </tags>   <text font="bold">return</text> <Math mode="inline" tex="m" text="m" xml:id="alg1.l6.m1">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">m</XMTok>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:elsif" xml:id="alg1.l7"><tags>
          <tag><text fontsize="80%">7:</text></tag>
          <tag role="refnum">7</tag>
        </tags>  <text font="bold">else</text> <text font="bold">if</text> <Math mode="inline" tex="A[m]&lt;k" text="A * delimited-[]@(m) &lt; k" xml:id="alg1.l7.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="less-than" role="RELOP">&lt;</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">A</XMTok>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="delimited-[]"/>
                    <XMRef idref="alg1.l7.m1.1"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">[</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="alg1.l7.m1.1">m</XMTok>
                    <XMTok role="CLOSE" stretchy="false">]</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
              <XMTok font="italic" role="UNKNOWN">k</XMTok>
            </XMApp>
          </XMath>
        </Math> <text font="bold">then</text>
</listingline>
      <listingline labels="LABEL:line:right" xml:id="alg1.l8"><tags>
          <tag><text fontsize="80%">8:</text></tag>
          <tag role="refnum">8</tag>
        </tags>   <Math mode="inline" tex="l\leftarrow m+1" text="l leftarrow m + 1" xml:id="alg1.l8.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">l</XMTok>
              <XMApp>
                <XMTok meaning="plus" role="ADDOP">+</XMTok>
                <XMTok font="italic" role="UNKNOWN">m</XMTok>
                <XMTok meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:else" xml:id="alg1.l9"><tags>
          <tag><text fontsize="80%">9:</text></tag>
          <tag role="refnum">9</tag>
        </tags>  <text font="bold">else</text>
</listingline>
      <listingline labels="LABEL:line:left" xml:id="alg1.l10"><tags>
          <tag><text fontsize="80%">10:</text></tag>
          <tag role="refnum">10</tag>
        </tags>   <Math mode="inline" tex="r\leftarrow m-1" text="r leftarrow m - 1" xml:id="alg1.l10.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">r</XMTok>
              <XMApp>
                <XMTok meaning="minus" role="ADDOP">-</XMTok>
                <XMTok font="italic" role="UNKNOWN">m</XMTok>
