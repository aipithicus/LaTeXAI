              </XMApp>
            </XMApp>
          </XMath>
        </Math>
</listingline>
      <listingline labels="LABEL:line:endif" xml:id="alg1.l11"><tags>
          <tag><text fontsize="80%">11:</text></tag>
          <tag role="refnum">11</tag>
        </tags>  <text font="bold">end</text> <text font="bold">if</text>
</listingline>
      <listingline labels="LABEL:line:endwhile" xml:id="alg1.l12"><tags>
          <tag><text fontsize="80%">12:</text></tag>
          <tag role="refnum">12</tag>
        </tags><text font="bold">end</text> <text font="bold">while</text>
</listingline>
