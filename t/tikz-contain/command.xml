<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="tikz"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <p>Inline</p>
    <picture class="ltx_tikz" height="0" tex="\tikz{\node{$a$};}" width="0" xml:id="p1.pic1">
      <g class="ltx_tikz_node">
        <Math mode="inline" tex="a" text="a" xml:id="p1.pic1.m1">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">a</XMTok>
          </XMath>
        </Math>
      </g>
    </picture>
    <p>and</p>
    <picture class="ltx_tikz" height="0" tex="\tikz \node{b};" width="0" xml:id="p1.pic2">
      <g class="ltx_tikz_node">
        <text>b</text>
      </g>
    </picture>
    <p>done.</p>
  </para>
</document>
