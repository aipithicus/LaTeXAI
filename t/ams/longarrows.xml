<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="mathtools"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <equation xml:id="S0.Ex1">
      <Math mode="display" tex="A\xlongrightarrow{\text{multiply the $2$nd column by $-1$}}B" text="A [multiply the 2nd column by -1]@(rightarrow) B" xml:id="S0.Ex1.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMText role="OVERACCENT"><text fontsize="70%">multiply the </text><Math mode="inline" tex="2" text="2" xml:id="S0.Ex1.m1.m1">
                  <XMath>
                    <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                  </XMath>
                </Math><text fontsize="70%">nd column by </text><Math mode="inline" tex="-1" text="- 1" xml:id="S0.Ex1.m1.m2">
                  <XMath>
                    <XMApp>
                      <XMTok fontsize="70%" meaning="minus" role="ADDOP">-</XMTok>
                      <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                    </XMApp>
                  </XMath>
                </Math></XMText>
              <XMTok name="rightarrow" role="ARROW" stretchy="true">→</XMTok>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex2">
      <Math mode="display" tex="A\xlongrightarrow[u]{v}B" text="A u@(v@(rightarrow)) B" xml:id="S0.Ex2.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMTok font="italic" fontsize="70%" role="UNDERACCENT">u</XMTok>
              <XMApp role="ARROW">
                <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
                <XMTok name="rightarrow" role="ARROW" stretchy="true">→</XMTok>
              </XMApp>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
    <equation xml:id="S0.Ex3">
      <Math mode="display" tex="A\xlongleftarrow[u]{v}B" text="A u@(v@(leftarrow)) B" xml:id="S0.Ex3.m1">
        <XMath>
          <XMApp>
            <XMApp role="ARROW">
              <XMTok font="italic" fontsize="70%" role="UNDERACCENT">u</XMTok>
              <XMApp role="ARROW">
                <XMTok font="italic" fontsize="70%" role="OVERACCENT">v</XMTok>
                <XMTok name="leftarrow" role="ARROW" stretchy="true">←</XMTok>
              </XMApp>
            </XMApp>
            <XMTok font="italic" role="UNKNOWN">A</XMTok>
            <XMTok font="italic" role="UNKNOWN">B</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
  </para>
</document>
