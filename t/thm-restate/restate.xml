  <resource src="ltx-article.css" type="text/css"/>
  <section inlist="toc" xml:id="S1">
    <tags>
      <tag>1</tag>
      <tag role="refnum">1</tag>
      <tag role="typerefnum">§1</tag>
    </tags>
    <title><tag close=" ">1</tag>Introduction</title>
    <para xml:id="S1.p1">
      <p>Here is our primary result:</p>
    </para>
    <theorem class="ltx_theorem_theorem" inlist="thm theorem:theorem" labels="LABEL:thm:conv LABEL:thmt@@thmConvergence" xml:id="Thmtheorem1">
      <tags>
        <tag>Theorem 1</tag>
        <tag role="refnum">1</tag>
        <tag role="typerefnum">Theorem 1</tag>
      </tags>
      <title class="ltx_runin"><tag><text font="bold">Theorem 1</text></tag><text font="bold"> </text>(Main Convergence)<text font="bold">.</text></title>
      <para xml:id="Thmtheorem1.p1">
        <p><text font="italic">Let <Math mode="inline" tex="(x_{n})_{n=1}^{\infty}" text="(x _ n _ (n = 1)) ^ infinity" xml:id="Thmtheorem1.p1.m1">
              <XMath>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMDual>
                      <XMRef idref="Thmtheorem1.p1.m1.1"/>
                      <XMWrap>
                        <XMTok font="upright" role="OPEN" stretchy="false">(</XMTok>
                        <XMApp xml:id="Thmtheorem1.p1.m1.1">
                          <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                          <XMTok role="UNKNOWN">x</XMTok>
                          <XMTok fontsize="70%" role="UNKNOWN">n</XMTok>
                        </XMApp>
                        <XMTok font="upright" role="CLOSE" stretchy="false">)</XMTok>
                      </XMWrap>
                    </XMDual>
                    <XMApp>
                      <XMTok font="upright" fontsize="70%" meaning="equals" role="RELOP">=</XMTok>
                      <XMTok fontsize="70%" role="UNKNOWN">n</XMTok>
                      <XMTok font="upright" fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                    </XMApp>
                  </XMApp>
                  <XMTok font="upright" fontsize="70%" meaning="infinity" name="infty" role="ID">∞</XMTok>
                </XMApp>
              </XMath>
            </Math> be a sequence such that <Math mode="inline" tex="x_{n}\to x^{*}" text="x _ n to x ^ *" xml:id="Thmtheorem1.p1.m2">
              <XMath>
                <XMApp>
                  <XMTok font="upright" name="to" role="ARROW">→</XMTok>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok role="UNKNOWN">x</XMTok>
                    <XMTok fontsize="70%" role="UNKNOWN">n</XMTok>
                  </XMApp>
                  <XMApp>
                    <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                    <XMTok role="UNKNOWN">x</XMTok>
                    <XMTok font="upright" fontsize="70%" meaning="times" role="MULOP">∗</XMTok>
                  </XMApp>
                </XMApp>
              </XMath>
            </Math> as <Math mode="inline" tex="n\to\infty" text="n to infinity" xml:id="Thmtheorem1.p1.m3">
              <XMath>
                <XMApp>
                  <XMTok font="upright" name="to" role="ARROW">→</XMTok>
                  <XMTok role="UNKNOWN">n</XMTok>
                  <XMTok font="upright" meaning="infinity" name="infty" role="ID">∞</XMTok>
                </XMApp>
              </XMath>
            </Math>.
Then for any continuous function <Math mode="inline" tex="f" text="f" xml:id="Thmtheorem1.p1.m4">
              <XMath>
                <XMTok role="UNKNOWN">f</XMTok>
              </XMath>
            </Math>, we have:</text></p>
        <equation labels="LABEL:eq:limit" xml:id="S1.E1">
          <tags>
            <tag>(1)</tag>
            <tag role="refnum">1</tag>
          </tags>
          <Math mode="display" tex="\lim_{n\to\infty}f(x_{n})=f(x^{*})." text="(limit _ (n to infinity))@(f * x _ n) = f * x ^ *" xml:id="S1.E1.m1">
            <XMath>
              <XMDual>
                <XMRef idref="S1.E1.m1.1"/>
                <XMWrap>
                  <XMApp xml:id="S1.E1.m1.1">
                    <XMTok meaning="equals" role="RELOP">=</XMTok>
                    <XMApp>
                      <XMApp>
                        <XMTok role="SUBSCRIPTOP" scriptpos="mid1"/>
                        <XMTok meaning="limit" role="LIMITOP" scriptpos="mid">lim</XMTok>
                        <XMApp>
                          <XMTok fontsize="70%" name="to" role="ARROW">→</XMTok>
                          <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
                          <XMTok fontsize="70%" meaning="infinity" name="infty" role="ID">∞</XMTok>
                        </XMApp>
                      </XMApp>
                      <XMApp>
                        <XMTok meaning="times" role="MULOP">⁢</XMTok>
                        <XMTok font="italic" role="UNKNOWN">f</XMTok>
                        <XMDual>
                          <XMRef idref="S1.E1.m1.1.1"/>
                          <XMWrap>
                            <XMTok role="OPEN" stretchy="false">(</XMTok>
                            <XMApp xml:id="S1.E1.m1.1.1">
                              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                              <XMTok font="italic" role="UNKNOWN">x</XMTok>
                              <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
                            </XMApp>
                            <XMTok role="CLOSE" stretchy="false">)</XMTok>
                          </XMWrap>
                        </XMDual>
                      </XMApp>
                    </XMApp>
                    <XMApp>
                      <XMTok meaning="times" role="MULOP">⁢</XMTok>
                      <XMTok font="italic" role="UNKNOWN">f</XMTok>
                      <XMDual>
                        <XMRef idref="S1.E1.m1.1.2"/>
                        <XMWrap>
                          <XMTok role="OPEN" stretchy="false">(</XMTok>
                          <XMApp xml:id="S1.E1.m1.1.2">
                            <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">x</XMTok>
                            <XMTok fontsize="70%" meaning="times" role="MULOP">∗</XMTok>
                          </XMApp>
                          <XMTok role="CLOSE" stretchy="false">)</XMTok>
                        </XMWrap>
                      </XMDual>
                    </XMApp>
                  </XMApp>
                  <XMTok role="PERIOD">.</XMTok>
                </XMWrap>
              </XMDual>
            </XMath>
          </Math>
        </equation>
      </para>
    </theorem>
    <para xml:id="S1.p2">
      <p>An intervening theorem to advance the counter:</p>
    </para>
    <theorem class="ltx_theorem_theorem" inlist="thm theorem:theorem" xml:id="Thmtheorem2">
      <tags>
        <tag>Theorem 2</tag>
        <tag role="refnum">2</tag>
        <tag role="typerefnum">Theorem 2</tag>
      </tags>
      <title class="ltx_runin"><tag><text font="bold">Theorem 2</text></tag><text font="bold">.</text></title>
      <para xml:id="Thmtheorem2.p1">
        <p><text font="italic">Every bounded sequence has a convergent subsequence.</text></p>
      </para>
    </theorem>
    <para xml:id="S1.p3">
      <p>A deferred lemma declared with restatable*:</p>
    </para>
  </section>
  <section inlist="toc" xml:id="S2">
    <tags>
      <tag>2</tag>
      <tag role="refnum">2</tag>
      <tag role="typerefnum">§2</tag>
    </tags>
    <title><tag close=" ">2</tag>Appendix: Deferred Proofs</title>
    <para xml:id="S2.p1">
      <p>Here we recall Theorem <ref labelref="LABEL:thm:conv"/>:</p>
    </para>
    <theorem class="ltx_theorem_theorem" inlist="thm theorem:theorem" xml:id="Thmtheorem1a">
      <tags>
        <tag>Theorem 1</tag>
        <tag role="refnum">1</tag>
        <tag role="typerefnum">Theorem 1</tag>
      </tags>
      <title class="ltx_runin"><tag><text font="bold">Theorem 1</text></tag><text font="bold"> </text>(Main Convergence)<text font="bold">.</text></title>
      <para xml:id="Thmtheorem1a.p1">
        <p><text font="italic">Let <Math mode="inline" tex="(x_{n})_{n=1}^{\infty}" text="(x _ n _ (n = 1)) ^ infinity" xml:id="Thmtheorem1a.p1.m1">
              <XMath>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMDual>
                      <XMRef idref="Thmtheorem1a.p1.m1.1"/>
                      <XMWrap>
                        <XMTok font="upright" role="OPEN" stretchy="false">(</XMTok>
                        <XMApp xml:id="Thmtheorem1a.p1.m1.1">
                          <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                          <XMTok role="UNKNOWN">x</XMTok>
                          <XMTok fontsize="70%" role="UNKNOWN">n</XMTok>
                        </XMApp>
                        <XMTok font="upright" role="CLOSE" stretchy="false">)</XMTok>
                      </XMWrap>
                    </XMDual>
                    <XMApp>
                      <XMTok font="upright" fontsize="70%" meaning="equals" role="RELOP">=</XMTok>
                      <XMTok fontsize="70%" role="UNKNOWN">n</XMTok>
                      <XMTok font="upright" fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                    </XMApp>
                  </XMApp>
                  <XMTok font="upright" fontsize="70%" meaning="infinity" name="infty" role="ID">∞</XMTok>
                </XMApp>
              </XMath>
            </Math> be a sequence such that <Math mode="inline" tex="x_{n}\to x^{*}" text="x _ n to x ^ *" xml:id="Thmtheorem1a.p1.m2">
              <XMath>
                <XMApp>
                  <XMTok font="upright" name="to" role="ARROW">→</XMTok>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok role="UNKNOWN">x</XMTok>
                    <XMTok fontsize="70%" role="UNKNOWN">n</XMTok>
                  </XMApp>
                  <XMApp>
                    <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                    <XMTok role="UNKNOWN">x</XMTok>
                    <XMTok font="upright" fontsize="70%" meaning="times" role="MULOP">∗</XMTok>
                  </XMApp>
                </XMApp>
              </XMath>
            </Math> as <Math mode="inline" tex="n\to\infty" text="n to infinity" xml:id="Thmtheorem1a.p1.m3">
              <XMath>
                <XMApp>
                  <XMTok font="upright" name="to" role="ARROW">→</XMTok>
                  <XMTok role="UNKNOWN">n</XMTok>
                  <XMTok font="upright" meaning="infinity" name="infty" role="ID">∞</XMTok>
                </XMApp>
              </XMath>
            </Math>.
Then for any continuous function <Math mode="inline" tex="f" text="f" xml:id="Thmtheorem1a.p1.m4">
              <XMath>
                <XMTok role="UNKNOWN">f</XMTok>
              </XMath>
            </Math>, we have:</text></p>
        <equation xml:id="S2.E2">
          <tags>
            <tag>(2)</tag>
            <tag role="refnum">2</tag>
          </tags>
          <Math mode="display" tex="\lim_{n\to\infty}f(x_{n})=f(x^{*})." text="(limit _ (n to infinity))@(f * x _ n) = f * x ^ *" xml:id="S2.E2.m1">
            <XMath>
              <XMDual>
                <XMRef idref="S2.E2.m1.1"/>
                <XMWrap>
                  <XMApp xml:id="S2.E2.m1.1">
                    <XMTok meaning="equals" role="RELOP">=</XMTok>
                    <XMApp>
                      <XMApp>
                        <XMTok role="SUBSCRIPTOP" scriptpos="mid1"/>
                        <XMTok meaning="limit" role="LIMITOP" scriptpos="mid">lim</XMTok>
                        <XMApp>
                          <XMTok fontsize="70%" name="to" role="ARROW">→</XMTok>
                          <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
                          <XMTok fontsize="70%" meaning="infinity" name="infty" role="ID">∞</XMTok>
                        </XMApp>
                      </XMApp>
                      <XMApp>
                        <XMTok meaning="times" role="MULOP">⁢</XMTok>
                        <XMTok font="italic" role="UNKNOWN">f</XMTok>
                        <XMDual>
                          <XMRef idref="S2.E2.m1.1.1"/>
                          <XMWrap>
                            <XMTok role="OPEN" stretchy="false">(</XMTok>
                            <XMApp xml:id="S2.E2.m1.1.1">
                              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                              <XMTok font="italic" role="UNKNOWN">x</XMTok>
                              <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
                            </XMApp>
                            <XMTok role="CLOSE" stretchy="false">)</XMTok>
                          </XMWrap>
                        </XMDual>
                      </XMApp>
                    </XMApp>
                    <XMApp>
                      <XMTok meaning="times" role="MULOP">⁢</XMTok>
                      <XMTok font="italic" role="UNKNOWN">f</XMTok>
                      <XMDual>
                        <XMRef idref="S2.E2.m1.1.2"/>
                        <XMWrap>
                          <XMTok role="OPEN" stretchy="false">(</XMTok>
                          <XMApp xml:id="S2.E2.m1.1.2">
                            <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">x</XMTok>
                            <XMTok fontsize="70%" meaning="times" role="MULOP">∗</XMTok>
                          </XMApp>
                          <XMTok role="CLOSE" stretchy="false">)</XMTok>
                        </XMWrap>
                      </XMDual>
                    </XMApp>
                  </XMApp>
                  <XMTok role="PERIOD">.</XMTok>
                </XMWrap>
              </XMDual>
            </XMath>
          </Math>
        </equation>
      </para>
    </theorem>
    <para xml:id="S2.p2">
      <p>And here we instantiate the deferred lemma:</p>
    </para>
    <theorem class="ltx_theorem_lemma" inlist="thm theorem:lemma" labels="LABEL:thmt@@lemBound" xml:id="Thmlemma1">
      <tags>
        <tag>Lemma 1</tag>
        <tag role="refnum">1</tag>
        <tag role="typerefnum">Lemma 1</tag>
      </tags>
      <title class="ltx_runin"><tag><text font="bold">Lemma 1</text></tag><text font="bold">.</text></title>
      <para xml:id="Thmlemma1.p1">
        <p><text font="italic">There exists a constant <Math mode="inline" tex="M&gt;0" text="M &gt; 0" xml:id="Thmlemma1.p1.m1">
              <XMath>
                <XMApp>
                  <XMTok font="upright" meaning="greater-than" role="RELOP">&gt;</XMTok>
                  <XMTok role="UNKNOWN">M</XMTok>
                  <XMTok font="upright" meaning="0" role="NUMBER">0</XMTok>
                </XMApp>
              </XMath>
            </Math> such that <Math mode="inline" tex="|f(x)|\leq M" text="absolute-value@(f * x) &lt;= M" xml:id="Thmlemma1.p1.m2">
              <XMath>
                <XMApp>
                  <XMTok font="upright" meaning="less-than-or-equals" name="leq" role="RELOP">≤</XMTok>
                  <XMDual>
                    <XMApp>
                      <XMTok meaning="absolute-value"/>
                      <XMRef idref="Thmlemma1.p1.m2.2"/>
                    </XMApp>
                    <XMWrap>
                      <XMTok font="upright" role="OPEN" stretchy="false">|</XMTok>
                      <XMApp xml:id="Thmlemma1.p1.m2.2">
                        <XMTok font="upright" meaning="times" role="MULOP">⁢</XMTok>
                        <XMTok role="UNKNOWN">f</XMTok>
                        <XMDual>
                          <XMRef idref="Thmlemma1.p1.m2.1"/>
                          <XMWrap>
                            <XMTok font="upright" role="OPEN" stretchy="false">(</XMTok>
                            <XMTok role="UNKNOWN" xml:id="Thmlemma1.p1.m2.1">x</XMTok>
                            <XMTok font="upright" role="CLOSE" stretchy="false">)</XMTok>
                          </XMWrap>
                        </XMDual>
                      </XMApp>
                      <XMTok font="upright" role="CLOSE" stretchy="false">|</XMTok>
                    </XMWrap>
                  </XMDual>
                  <XMTok role="UNKNOWN">M</XMTok>
                </XMApp>
              </XMath>
            </Math> for all <Math mode="inline" tex="x" text="x" xml:id="Thmlemma1.p1.m3">
              <XMath>
                <XMTok role="UNKNOWN">x</XMTok>
              </XMath>
            </Math>.</text></p>
      </para>
    </theorem>
    <para xml:id="S2.p3">
      <p>A final theorem to verify counter continuity:</p>
    </para>
    <theorem class="ltx_theorem_theorem" inlist="thm theorem:theorem" xml:id="Thmtheorem3">
      <tags>
        <tag>Theorem 3</tag>
        <tag role="refnum">3</tag>
        <tag role="typerefnum">Theorem 3</tag>
      </tags>
      <title class="ltx_runin"><tag><text font="bold">Theorem 3</text></tag><text font="bold">.</text></title>
      <para xml:id="Thmtheorem3.p1">
        <p><text font="italic">The limit is unique.</text></p>
      </para>
    </theorem>
  </section>
